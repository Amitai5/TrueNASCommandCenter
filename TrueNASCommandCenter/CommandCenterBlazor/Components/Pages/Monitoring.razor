@page "/monitoring"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IUptimeKumaSyncService UptimeKumaSyncService

<PageTitle>Monitoring · TrueNAS Command Center</PageTitle>

<div class="page monitoring-page">
    <header class="page-header">
        <div>
            <h1>Monitoring</h1>
            <p class="subtitle">Read-only availability and performance reports imported from Uptime Kuma.</p>
        </div>
        <div class="actions">
            @if (KumaBrowserUrl() is not null)
            {
                <a class="button" href="@KumaBrowserUrl()" target="_blank" rel="noopener noreferrer">Open Uptime Kuma ↗</a>
            }
            <button class="primary" disabled="@(_busy || !HasConnectionSettings())" @onclick="SyncAsync">@(_busy ? "Syncing…" : "Sync now")</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_error ? "danger" : "success")" role="status">@_message</div>
    }

    @if (_loading)
    {
        <div class="panel empty-state"><span class="spinner"></span> Loading Uptime Kuma reports…</div>
    }
    else if (!HasConnectionSettings() && PresentMonitors().Count == 0)
    {
        <div class="panel empty-state">
            <h2>Uptime Kuma is not configured</h2>
            <p class="muted">Add a Kuma connection URL and, when required, a Prometheus API key.</p>
            <a class="button primary" href="/settings">Configure Uptime Kuma</a>
        </div>
    }
    else
    {
        @if (!HasConnectionSettings())
        {
            <div class="notice warning" role="status">
                <strong>Connection settings are missing.</strong>
                <p>Showing the last imported report. <a href="/settings">Configure Uptime Kuma</a> to refresh it.</p>
            </div>
        }
        <section class="summary-grid monitoring-summary" aria-label="Uptime Kuma summary">
            <div class="summary-item"><strong>@PresentMonitors().Count</strong><span>Monitors</span></div>
            <div class="summary-item"><strong>@Count(UptimeKumaMonitorStatus.Up)</strong><span>Up</span></div>
            <div class="summary-item"><strong>@Count(UptimeKumaMonitorStatus.Down)</strong><span>Down</span></div>
            <div class="summary-item"><strong>@Count(UptimeKumaMonitorStatus.Maintenance)</strong><span>Maintenance</span></div>
        </section>

        <div class="monitoring-connection-row">
            <p class="muted">Last successful import: @FormatDate(_settings?.LastUptimeKumaSuccessUtc) · @RefreshDescription()</p>
            <span class="badge @ConnectionClass()">@ConnectionText()</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_settings?.LastUptimeKumaError))
        {
            <div class="notice warning"><strong>Most recent sync failed.</strong> Showing the last successfully imported data. @_settings?.LastUptimeKumaError</div>
        }

        <div class="monitor-filters panel-toolbar">
            <div class="field">
                <label class="visually-hidden" for="monitor-search">Search monitors</label>
                <input id="monitor-search" type="search" placeholder="Search by monitor, app, URL, host, or port" autocomplete="off" @bind="_searchTerm" @bind:event="oninput" />
            </div>
            <div class="field monitor-filter-status">
                <label class="visually-hidden" for="monitor-status">Filter by status</label>
                <select id="monitor-status" @bind="_statusFilter">
                    <option value="all">All statuses</option>
                    <option value="up">Up</option>
                    <option value="down">Down</option>
                    <option value="pending">Pending</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="unknown">Unknown</option>
                </select>
            </div>
            <span class="muted">Showing @FilteredMonitors().Count of @PresentMonitors().Count</span>
        </div>

        @if (PresentMonitors().Count == 0)
        {
            <div class="panel empty-state"><h2>No monitor metrics imported</h2><p class="muted">Test the connection and confirm Kuma's <code>/metrics</code> endpoint returns monitor data.</p></div>
        }
        else if (FilteredMonitors().Count == 0)
        {
            <div class="panel empty-state"><h2>No matching monitors</h2><button @onclick="ClearFilters">Clear filters</button></div>
        }
        else
        {
            <div class="table-wrap desktop-monitor-table">
                <table>
                    <thead><tr><th>Monitor</th><th>Kuma status</th><th>Linked app</th><th>Response</th><th>Uptime</th><th>Certificate</th></tr></thead>
                    <tbody>
                        @foreach (var monitor in FilteredMonitors())
                        {
                            <tr>
                                <td><strong>@monitor.Name</strong><span class="app-meta">@MonitorTarget(monitor) · @monitor.Type</span></td>
                                <td><span class="badge @StatusClass(monitor.Status)">@StatusText(monitor.Status)</span></td>
                                <td>@if (monitor.App is not null) { <a href="@AppPath(monitor.AppId!)">@monitor.App.Name</a> } else { <span class="muted">Not linked</span> }</td>
                                <td><strong>@FormatMilliseconds(monitor.ResponseTimeMilliseconds)</strong><span class="app-meta">@FormatMilliseconds(monitor.AverageResponseTimeMilliseconds30Days) 30-day avg</span></td>
                                <td><div class="uptime-values"><span><strong>@FormatPercent(monitor.UptimeRatio1Day)</strong><small>1 day</small></span><span><strong>@FormatPercent(monitor.UptimeRatio30Days)</strong><small>30 days</small></span><span><strong>@FormatPercent(monitor.UptimeRatio365Days)</strong><small>1 year</small></span></div></td>
                                <td>@CertificateText(monitor)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mobile-monitor-list">
                @foreach (var monitor in FilteredMonitors())
                {
                    <article class="panel monitor-card">
                        <div class="row"><div><h2>@monitor.Name</h2><span class="app-meta">@MonitorTarget(monitor)</span></div><span class="badge @StatusClass(monitor.Status)">@StatusText(monitor.Status)</span></div>
                        <dl class="details-list"><dt>Linked app</dt><dd>@if (monitor.App is not null) { <a href="@AppPath(monitor.AppId!)">@monitor.App.Name</a> } else { <span>Not linked</span> }</dd><dt>Response</dt><dd>@FormatMilliseconds(monitor.ResponseTimeMilliseconds)</dd><dt>30-day average</dt><dd>@FormatMilliseconds(monitor.AverageResponseTimeMilliseconds30Days)</dd><dt>1-day uptime</dt><dd>@FormatPercent(monitor.UptimeRatio1Day)</dd><dt>30-day uptime</dt><dd>@FormatPercent(monitor.UptimeRatio30Days)</dd><dt>1-year uptime</dt><dd>@FormatPercent(monitor.UptimeRatio365Days)</dd><dt>Certificate</dt><dd>@CertificateText(monitor)</dd></dl>
                    </article>
                }
            </div>
        }
    }
</div>

@code {
    private List<UptimeKumaMonitorRecord> _monitors = [];
    private SettingsRecord? _settings;
    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string? _message;
    private bool _error;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.Settings.AsNoTracking().SingleAsync(item => item.Id == 1);
        _monitors = await db.UptimeKumaMonitors.AsNoTracking().Include(monitor => monitor.App).OrderBy(monitor => monitor.Name).ToListAsync();
        _loading = false;
    }

    private async Task SyncAsync()
    {
        _busy = true;
        try
        {
            var result = await UptimeKumaSyncService.SynchronizeAsync(force: true);
            _message = result.Message;
            _error = !result.Success;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private List<UptimeKumaMonitorRecord> PresentMonitors() => _monitors.Where(monitor => monitor.IsPresent).ToList();

    private List<UptimeKumaMonitorRecord> FilteredMonitors()
    {
        var query = PresentMonitors().AsEnumerable();
        if (_statusFilter != "all" && Enum.TryParse<UptimeKumaMonitorStatus>(_statusFilter, true, out var status))
        {
            query = query.Where(monitor => monitor.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(monitor => Contains(monitor.Name, term) || Contains(monitor.Type, term) || Contains(monitor.Url, term) || Contains(monitor.Hostname, term) || Contains(monitor.Port?.ToString(), term) || Contains(monitor.App?.Name, term));
        }

        return query.ToList();
    }

    private int Count(UptimeKumaMonitorStatus status) => PresentMonitors().Count(monitor => monitor.Status == status);
    private void ClearFilters() { _searchTerm = string.Empty; _statusFilter = "all"; }
    private string? KumaBrowserUrl() => _settings?.UptimeKumaBrowserUrl ?? _settings?.UptimeKumaBaseUrl;
    private bool HasConnectionSettings() => !string.IsNullOrWhiteSpace(_settings?.UptimeKumaBaseUrl);
    private string RefreshDescription() => HasConnectionSettings() ? $"Automatic refresh every {_settings!.UptimeKumaRefreshIntervalSeconds} seconds" : "Automatic refresh unavailable";
    private string ConnectionText() => !HasConnectionSettings() ? "Configuration needed" : IsStale() ? "Data stale" : _settings!.LastUptimeKumaSuccessUtc is null ? "Not synchronized" : "Connected";
    private string ConnectionClass() => !HasConnectionSettings() ? "info" : IsStale() ? "warning" : _settings!.LastUptimeKumaSuccessUtc is null ? "info" : "success";
    private bool IsStale() => HasConnectionSettings() && _settings!.LastUptimeKumaSuccessUtc is { } success && DateTime.UtcNow - DateTime.SpecifyKind(success, DateTimeKind.Utc) > TimeSpan.FromSeconds(Math.Max(90, _settings.UptimeKumaRefreshIntervalSeconds * 3));
    private string FormatDate(DateTime? value) => DisplayTimeFormatter.Format(value, _settings?.TimeZoneId);
    private static string FormatPercent(double? value) => value is null ? "—" : $"{value.Value:P2}";
    private static string FormatMilliseconds(double? value) => value is null ? "—" : $"{value.Value:N0} ms";
    private static string MonitorTarget(UptimeKumaMonitorRecord monitor) => monitor.Url ?? (monitor.Hostname is not null ? $"{monitor.Hostname}{(monitor.Port is null ? string.Empty : $":{monitor.Port}")}" : monitor.Port?.ToString() ?? "Target unavailable");
    private static string CertificateText(UptimeKumaMonitorRecord monitor) => monitor.CertificateIsValid switch { false => "Invalid", true when monitor.CertificateDaysRemaining is not null => $"{monitor.CertificateDaysRemaining:N0} days", true => "Valid", _ => "—" };
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static string StatusText(UptimeKumaMonitorStatus status) => status switch { UptimeKumaMonitorStatus.Up => "Up", UptimeKumaMonitorStatus.Down => "Down", UptimeKumaMonitorStatus.Pending => "Pending", UptimeKumaMonitorStatus.Maintenance => "Maintenance", _ => "Unknown" };
    private static string StatusClass(UptimeKumaMonitorStatus status) => status switch { UptimeKumaMonitorStatus.Up => "success", UptimeKumaMonitorStatus.Down => "danger", UptimeKumaMonitorStatus.Pending => "warning", UptimeKumaMonitorStatus.Maintenance => "info", _ => string.Empty };
    private static string AppPath(string appId) => $"/apps/{Uri.EscapeDataString(appId)}";
}

@* The dashboard owns the root route. *@
@page "/apps"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IUpdateCoordinator Coordinator
@inject IAppManagementService AppManagementService
@inject IAppLinkService AppLinkService
@inject IAppResourceMonitor ResourceMonitor
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Apps · TrueNAS Command Center</PageTitle>

<div class="page apps-page">
    <header class="page-header">
        <div>
            <h1>Apps</h1>
            <p class="subtitle">Monitor, start, stop, restart, and safely update your TrueNAS apps.</p>
        </div>
        <div class="actions">
            <button disabled="@_busy" @onclick="RefreshAppsAsync">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                Refresh apps
            </button>
            <button class="primary" disabled="@_busy" @onclick="CheckAndUpdateAsync">Check &amp; update</button>
        </div>
    </header>

    @if (_settings is not null && !_settings.OnboardingCompleted)
    {
        <div class="notice warning">
            <strong>Setup is not complete.</strong>
            Connect TrueNAS, choose a schedule and notification events, then discover apps.
            <a href="/onboarding">Continue setup</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_messageIsError ? "danger" : "success")" role="status">@_message</div>
    }

    <section class="summary-grid app-summary-grid" aria-label="App summary">
        <div class="summary-item">
            <strong>@_apps.Count</strong>
            <span>Applications</span>
        </div>
        <div class="summary-item">
            <strong>@_apps.Count(app => app.CatalogUpdateAvailable || app.ImageUpdateAvailable)</strong>
            <span>Updates available</span>
        </div>
        <div class="summary-item">
            <strong>@_apps.Count(app => app.HealthState is AppHealthState.Stopped or AppHealthState.Degraded)</strong>
            <span>Need attention</span>
        </div>
    </section>

    @if (_loading)
    {
        <div class="panel empty-state state-loading"><span class="spinner"></span><strong>Loading apps…</strong></div>
    }
    else if (_apps.Count == 0)
    {
        <div class="panel empty-state">
            <span class="state-icon" aria-hidden="true"><NavIcon Name="apps" /></span>
            <h2>No apps discovered</h2>
            <p class="muted">Configure the TrueNAS connection, then refresh the app list. New apps remain Unconfigured.</p>
            <div class="actions" style="justify-content:center">
                <a class="button" href="/settings">Connection settings</a>
                <button class="primary" disabled="@_busy" @onclick="RefreshAppsAsync">Refresh apps</button>
            </div>
        </div>
    }
    else
    {
        var filteredApps = FilterApps();
        <div class="app-search-bar panel-toolbar">
            <div class="field">
                <label class="visually-hidden" for="app-search">Search applications</label>
                <input id="app-search" type="search" placeholder="Search apps by name, group, status, version, or port" autocomplete="off" @bind="_searchTerm" @bind:event="oninput" />
            </div>
            <div class="field app-organization-filter">
                <label class="visually-hidden" for="app-organization">Filter applications by group</label>
                <select id="app-organization" @bind="_organizationFilter">
                    <option value="all">All apps</option>
                    <option value="favorites">Favorites</option>
                    <option value="ungrouped">Ungrouped</option>
                    @foreach (var groupName in GroupOptions())
                    {
                        <option value="@GroupFilterValue(groupName)">@groupName</option>
                    }
                </select>
            </div>
            <span class="muted" aria-live="polite">Showing @filteredApps.Count of @_apps.Count</span>
            @if (!string.IsNullOrWhiteSpace(_searchTerm) || _organizationFilter != "all")
            {
                <button class="small" @onclick="ClearFilters">Clear</button>
            }
        </div>

        @if (filteredApps.Count == 0)
        {
            <div class="panel empty-state">
                <span class="state-icon" aria-hidden="true"><NavIcon Name="discover" /></span>
                <h2>No matching apps</h2>
                <p class="muted">Try a different app name, group, status, version, or port.</p>
                <button @onclick="ClearFilters">Clear filters</button>
            </div>
        }
        else
        {
            <div class="table-wrap desktop-app-table">
            <table>
                <thead>
                    <tr>
                        <th>Application</th>
                        <th>Health</th>
                        <th>Ports</th>
                        <th>Resources</th>
                        <th>Version / update</th>
                        <th>Policy</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in filteredApps)
                    {
                        var webUi = AppLinkService.ResolveWebUiLinks(app, _settings?.PortalHostOverride, new Uri(Navigation.Uri)).SelectedUrl;
                        var resourceUsage = ResourceUsage(app.Id);
                        <tr>
                            <td>
                                <div class="app-identity-cell">
                                    <button class="favorite-toggle" aria-label="@(app.IsFavorite ? $"Remove {app.Name} from favorites" : $"Add {app.Name} to favorites")" aria-pressed="@(app.IsFavorite ? "true" : "false")" title="@(app.IsFavorite ? "Remove from favorites" : "Add to favorites")" disabled="@(_favoriteBusyId == app.Id)" @onclick="() => ToggleFavoriteAsync(app)">@(app.IsFavorite ? "★" : "☆")</button>
                                    <span>
                                        <a class="app-name" href="@AppPath(app.Id)">@app.Name</a>
                                        <span class="app-meta">@(app.IsCustom ? "Custom" : app.Train ?? "Catalog")</span>
                                        @if (!string.IsNullOrWhiteSpace(app.GroupName))
                                        {
                                            <span class="app-group-badge">@app.GroupName</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="health-monitoring-cell">
                                <span class="badge @HealthClass(app.HealthState)">@HealthText(app.HealthState)</span>
                                <span class="app-meta">Kuma: @KumaText(app)</span>
                            </td>
                            <td>
                                @if (app.Ports.Count == 0)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <div class="port-list">@foreach (var port in app.Ports.OrderBy(port => port.HostPort)) { <code>@port.HostPort/@port.Protocol</code> }</div>
                                }
                            </td>
                            <td>
                                @if (resourceUsage is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <div class="resource-compact" title="Network: ↓ @FormatRate(resourceUsage.NetworkReceiveBytesPerSecond) · ↑ @FormatRate(resourceUsage.NetworkTransmitBytesPerSecond)">
                                        <span><strong>@resourceUsage.CpuUsagePercent%</strong> CPU</span>
                                        <span><strong>@FormatBytes(resourceUsage.MemoryBytes)</strong> RAM</span>
                                    </div>
                                }
                            </td>
                            <td><strong>@(app.HumanVersion ?? app.InstalledVersion ?? "—")</strong><span class="app-meta">@AvailableText(app)</span></td>
                            <td>
                                <span class="badge @PolicyClass(app.Policy)">@PolicyText(app.Policy)</span>
                                @if (app.Policy == AppPolicy.AutoUpdate && app.CatalogUpdateAvailable)
                                {
                                    <span class="app-meta">@ScopeText(app.VersionScope)</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="button small" href="@AppSettingsPath(app.Id)">Settings</a>
                                    <a class="button small" href="@AppPath(app.Id)">Details</a>
                                    @if (webUi is not null)
                                    {
                                        <a class="button small primary" href="@webUi" target="_blank" rel="noopener noreferrer">Web UI ↗</a>
                                    }
                                    @if (IsDown(app.State))
                                    {
                                        <button class="small primary" disabled="@_busy" @onclick="() => ManageAppAsync(app, AppLifecycleAction.Start)">Start</button>
                                    }
                                    @if (app.CatalogUpdateAvailable || app.ImageUpdateAvailable)
                                    {
                                        <button class="small primary" disabled="@_busy" @onclick="() => UpdateAppAsync(app)">Update</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <div class="mobile-app-list">
            @foreach (var app in filteredApps)
            {
                var webUi = AppLinkService.ResolveWebUiLinks(app, _settings?.PortalHostOverride, new Uri(Navigation.Uri)).SelectedUrl;
                var resourceUsage = ResourceUsage(app.Id);
                <article class="mobile-app-card">
                    <div class="row">
                        <div class="app-identity-cell">
                            <button class="favorite-toggle" aria-label="@(app.IsFavorite ? $"Remove {app.Name} from favorites" : $"Add {app.Name} to favorites")" aria-pressed="@(app.IsFavorite ? "true" : "false")" disabled="@(_favoriteBusyId == app.Id)" @onclick="() => ToggleFavoriteAsync(app)">@(app.IsFavorite ? "★" : "☆")</button>
                            <span>
                                <a class="app-name" href="@AppPath(app.Id)">@app.Name</a>
                                <span class="app-meta">@(app.HumanVersion ?? app.InstalledVersion ?? "Version unknown") · @(app.IsCustom ? "Custom" : app.Train ?? "Catalog")</span>
                                @if (!string.IsNullOrWhiteSpace(app.GroupName))
                                {
                                    <span class="app-group-badge">@app.GroupName</span>
                                }
                            </span>
                        </div>
                        <span class="badge @HealthClass(app.HealthState)">@HealthText(app.HealthState)</span>
                    </div>
                    <div class="port-list">@if (app.Ports.Count == 0) { <span class="muted">No published ports</span> } else { @foreach (var port in app.Ports.OrderBy(port => port.HostPort)) { <code>@port.HostPort/@port.Protocol</code> } }</div>
                    @if (resourceUsage is not null)
                    {
                        <div class="mobile-resource-summary">
                            <span><strong>@resourceUsage.CpuUsagePercent%</strong> CPU</span>
                            <span><strong>@FormatBytes(resourceUsage.MemoryBytes)</strong> RAM</span>
                            <span>↓ @FormatRate(resourceUsage.NetworkReceiveBytesPerSecond)</span>
                            <span>↑ @FormatRate(resourceUsage.NetworkTransmitBytesPerSecond)</span>
                        </div>
                    }
                    <div class="row">
                        <span class="badge @PolicyClass(app.Policy)">@PolicyText(app.Policy)</span>
                        <span class="badge @KumaClass(app)">Kuma: @KumaText(app)</span>
                    </div>
                    <div class="actions">
                        <a class="button small" href="@AppSettingsPath(app.Id)">Settings</a>
                        <a class="button small" href="@AppPath(app.Id)">View details</a>
                        @if (webUi is not null)
                        {
                            <a class="button small primary" href="@webUi" target="_blank" rel="noopener noreferrer">Web UI ↗</a>
                        }
                        @if (IsDown(app.State))
                        {
                            <button class="small primary" disabled="@_busy" @onclick="() => ManageAppAsync(app, AppLifecycleAction.Start)">Start</button>
                        }
                        @if (app.CatalogUpdateAvailable || app.ImageUpdateAvailable)
                        {
                            <button class="small primary" disabled="@_busy" @onclick="() => UpdateAppAsync(app)">Update now</button>
                        }
                    </div>
                </article>
            }
            </div>
        }
    }
</div>

@code {
    private const string GroupFilterPrefix = "group:";
    private List<AppRecord> _apps = [];
    private SettingsRecord? _settings;
    private bool _loading = true;
    private bool _busy;
    private bool _messageIsError;
    private string? _message;
    private string? _favoriteBusyId;
    private string _searchTerm = string.Empty;
    private string _organizationFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        ResourceMonitor.Updated += OnResourcesUpdated;
        await LoadAsync();
        if (_settings is not null && !_settings.OnboardingCompleted)
        {
            Navigation.NavigateTo("/onboarding");
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _apps = await db.Apps.AsNoTracking().AsSplitQuery().Include(app => app.Ports).Include(app => app.Portals).Include(app => app.UptimeKumaMonitors).Where(app => app.IsInstalled).OrderBy(app => app.Name).ToListAsync();
        _settings = await db.Settings.AsNoTracking().SingleAsync(item => item.Id == 1);
        _loading = false;
    }

    private List<AppRecord> FilterApps()
    {
        IEnumerable<AppRecord> apps = _apps;
        apps = _organizationFilter switch
        {
            "favorites" => apps.Where(app => app.IsFavorite),
            "ungrouped" => apps.Where(app => string.IsNullOrWhiteSpace(app.GroupName)),
            _ when _organizationFilter.StartsWith(GroupFilterPrefix, StringComparison.Ordinal) => apps.Where(app => string.Equals(app.GroupName, _organizationFilter[GroupFilterPrefix.Length..], StringComparison.OrdinalIgnoreCase)),
            _ => apps
        };

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var searchTerm = _searchTerm.Trim();
            apps = apps.Where(app =>
                Contains(app.Name, searchTerm) ||
                Contains(app.GroupName, searchTerm) ||
                Contains(app.State, searchTerm) ||
                Contains(app.StatusLabel, searchTerm) ||
                Contains(HealthText(app.HealthState), searchTerm) ||
                Contains(KumaText(app), searchTerm) ||
                Contains(PolicyText(app.Policy), searchTerm) ||
                Contains(app.HumanVersion, searchTerm) ||
                Contains(app.InstalledVersion, searchTerm) ||
                Contains(app.LatestHumanVersion, searchTerm) ||
                Contains(app.LatestVersion, searchTerm) ||
                Contains(app.Train, searchTerm) ||
                app.Ports.Any(port => Contains($"{port.HostPort}/{port.Protocol}", searchTerm)));
        }

        return apps
            .OrderByDescending(app => app.IsFavorite)
            .ThenBy(app => string.IsNullOrWhiteSpace(app.GroupName))
            .ThenBy(app => app.GroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(app => app.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _organizationFilter = "all";
    }

    private IEnumerable<string> GroupOptions() => _apps
        .Select(app => app.GroupName)
        .OfType<string>()
        .Where(groupName => !string.IsNullOrWhiteSpace(groupName))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(groupName => groupName, StringComparer.OrdinalIgnoreCase);

    private static string GroupFilterValue(string groupName) => $"{GroupFilterPrefix}{groupName}";

    private async Task ToggleFavoriteAsync(AppRecord app)
    {
        _favoriteBusyId = app.Id;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var persistedApp = await db.Apps.SingleAsync(candidate => candidate.Id == app.Id);
            persistedApp.IsFavorite = !persistedApp.IsFavorite;
            await db.SaveChangesAsync();
            app.IsFavorite = persistedApp.IsFavorite;
        }
        catch
        {
            _message = $"The favorite setting for {app.Name} could not be saved.";
            _messageIsError = true;
        }
        finally
        {
            _favoriteBusyId = null;
        }
    }

    private AppResourceUsage? ResourceUsage(string appId) => ResourceMonitor.Current.TryGetValue(appId, out var usage) ? usage : null;

    private void OnResourcesUpdated() => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshAppsAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Coordinator.RefreshAppsAsync();
            _message = result.Message;
            _messageIsError = result.Status == RunStatus.Failed;
        }
        catch
        {
            _message = "The app list could not be refreshed.";
            _messageIsError = true;
        }
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    private Task CheckAndUpdateAsync() => RunAsync(RunTrigger.CheckAndUpdateNow, true);

    private async Task UpdateAppAsync(AppRecord app)
    {
        var warning = app.State is "STOPPED" or "CRASHED"
            ? $"The app is {app.State}. TrueNAS may change its state during the update. Continue?"
            : $"Update {app.Name} through TrueNAS now?";
        if (!await JS.InvokeAsync<bool>("confirm", warning))
        {
            return;
        }

        await RunAsync(RunTrigger.UpdateNow, true, app.Id, riskyStateConfirmed: true);
    }

    private async Task ManageAppAsync(AppRecord app, AppLifecycleAction action)
    {
        if (action == AppLifecycleAction.Restart && !await JS.InvokeAsync<bool>("confirm", $"Restart {app.Name} through TrueNAS now?"))
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var result = await AppManagementService.ExecuteAsync(app.Id, action);
            _message = result.Message;
            _messageIsError = !result.Success;
        }
        catch
        {
            _message = $"{app.Name} could not be {PastTense(action)}.";
            _messageIsError = true;
        }
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    private async Task RunAsync(
        RunTrigger trigger,
        bool execute,
        string? appId = null,
        bool riskyStateConfirmed = false)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Coordinator.CheckAndUpdateAsync(trigger, execute, appId, riskyStateConfirmed);
            _message = result.Message;
            _messageIsError = result.Status is RunStatus.Failed or RunStatus.PartiallySucceeded;
        }
        catch
        {
            _message = "The run could not be started.";
            _messageIsError = true;
        }
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    private static string AvailableText(AppRecord app) =>
        app.CatalogUpdateAvailable
            ? app.LatestHumanVersion ?? app.LatestVersion ?? "Catalog update"
            : app.ImageUpdateAvailable
                ? "Image update"
                : "—";

    private static bool Contains(string? value, string searchTerm) => value?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true;

    private static string PolicyText(AppPolicy? policy) => policy switch
    {
        AppPolicy.AutoUpdate => "Auto update",
        AppPolicy.NotifyOnly => "Notify only",
        AppPolicy.Ignore => "Ignore",
        _ => "Needs configuration"
    };

    private static string PolicyClass(AppPolicy? policy) => policy switch
    {
        AppPolicy.AutoUpdate => "success",
        AppPolicy.NotifyOnly => "warning",
        AppPolicy.Ignore => "",
        _ => "info"
    };

    private static string ScopeText(VersionScope scope) => scope switch
    {
        VersionScope.AnyVersion => "Any version",
        VersionScope.MinorAndPatch => "Minor + patch",
        VersionScope.PatchOnly => "Patch only",
        _ => scope.ToString()
    };

    private static string StatusClass(AppRecord app) =>
        app.StatusLabel is "Up to date" ? "success" :
        app.StatusLabel is "Crashed" ? "danger" :
        app.StatusLabel.StartsWith("Failed", StringComparison.OrdinalIgnoreCase) ? "danger" :
        app.StatusLabel.StartsWith("Blocked", StringComparison.OrdinalIgnoreCase) ? "danger" :
        app.CatalogUpdateAvailable || app.ImageUpdateAvailable ? "warning" : "info";

    private static string HealthText(AppHealthState state) => state switch
    {
        AppHealthState.Running => "Running",
        AppHealthState.Degraded => "Degraded",
        AppHealthState.Stopped => "Stopped",
        AppHealthState.Maintenance => "Maintenance",
        _ => "Unknown"
    };

    private static string HealthClass(AppHealthState state) => state switch
    {
        AppHealthState.Running => "success",
        AppHealthState.Degraded => "warning",
        AppHealthState.Stopped => "danger",
        AppHealthState.Maintenance => "info",
        _ => string.Empty
    };

    private static string KumaText(AppRecord app)
    {
        if (app.UptimeKumaMonitors.Count == 0)
        {
            return "Not linked";
        }

        if (app.UptimeKumaMonitors.Any(monitor => monitor.Status == UptimeKumaMonitorStatus.Down))
        {
            return "Down";
        }

        if (app.UptimeKumaMonitors.Any(monitor => monitor.Status == UptimeKumaMonitorStatus.Pending))
        {
            return "Pending";
        }

        if (app.UptimeKumaMonitors.All(monitor => monitor.Status == UptimeKumaMonitorStatus.Maintenance))
        {
            return "Maintenance";
        }

        return app.UptimeKumaMonitors.Any(monitor => monitor.Status == UptimeKumaMonitorStatus.Up) ? "Up" : "Unknown";
    }

    private static string KumaClass(AppRecord app) => KumaText(app) switch
    {
        "Up" => "success",
        "Down" => "danger",
        "Pending" => "warning",
        "Maintenance" => "info",
        _ => string.Empty
    };

    private static string AppPath(string appId) => $"/apps/{Uri.EscapeDataString(appId)}";

    private static string AppSettingsPath(string appId) => $"/apps/{Uri.EscapeDataString(appId)}/settings";

    private static bool IsDown(string state) => state is "STOPPED" or "CRASHED";

    private static string PastTense(AppLifecycleAction action) => action switch
    {
        AppLifecycleAction.Start => "started",
        AppLifecycleAction.Stop => "stopped",
        AppLifecycleAction.Restart => "restarted",
        _ => "managed"
    };

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null)
        {
            return "—";
        }

        string[] units = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"];
        var value = Math.Max(0, (double)bytes.Value);
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.#} {units[unitIndex]}";
    }

    private static string FormatRate(long bytesPerSecond) => $"{FormatBytes(bytesPerSecond)}/s";

    /// <inheritdoc />
    public void Dispose()
    {
        ResourceMonitor.Updated -= OnResourcesUpdated;
    }
}

@page "/"
@inject DashboardOverviewService DashboardService
@inject ITrueNasServerAddressService ServerAddressService
@inject IStoragePoolOverviewService PoolOverviewService
@inject IScheduleService ScheduleService
@inject DashboardRefreshService DashboardRefreshService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Dashboard · TrueNAS Command Center</PageTitle>

<div class="page dashboard-page">
    <header class="page-header">
        <div>
            <h1>Dashboard</h1>
            <p class="subtitle">TrueNAS health, app availability, and recent automation at a glance.</p>
        </div>
        <button class="primary" disabled="@_loading" @onclick="RefreshAsync">
            @if (_loading)
            {
                <span class="spinner"></span>
            }
            @(_loading ? _refreshStage : "Refresh dashboard")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_messageIsError ? "danger" : "success")" role="status">@_message</div>
    }

    @if (_loading && _overview is null)
    {
        <div class="panel empty-state state-loading"><span class="spinner"></span><strong>Loading dashboard…</strong></div>
    }
    else if (_overview is not null)
    {
        <section class="summary-grid dashboard-summary" aria-label="System summary">
            <a class="summary-item summary-link" href="/apps">
                <strong>@_overview.RunningAppCount / @_overview.AppCount</strong>
                <span>Apps running</span>
            </a>
            <a class="summary-item summary-link" href="#attention">
                <strong>@AttentionCount()</strong>
                <span>Need attention</span>
            </a>
            <a class="summary-item summary-link" href="/monitoring">
                <strong>@_overview.MonitorsUp / @_overview.MonitorCount</strong>
                <span>Kuma monitors up</span>
            </a>
            <a class="summary-item summary-link" href="/settings">
                <strong>@FormatNextRun()</strong>
                <span>Next scheduled run</span>
            </a>
        </section>

        <section class="panel pool-overview dashboard-pools" aria-labelledby="pool-overview-heading">
            <div class="panel-heading-row">
                <div>
                    <h2 id="pool-overview-heading">Storage pools</h2>
                    <p class="muted">Capacity and health reported by TrueNAS.</p>
                </div>
                <button class="small" disabled="@_poolLoading" @onclick="LoadPoolOverviewAsync">Refresh pools</button>
            </div>
            @if (_poolLoading)
            {
                <div class="inline-loading"><span class="spinner"></span> Loading pool health…</div>
            }
            else if (_poolOverview?.RequiresPoolRead == true)
            {
                <div class="optional-feature-state">
                    <strong>Pool health is optional.</strong>
                    <span>Add the <code>POOL_READ</code> role to show storage capacity.</span>
                    <a href="/help">Setup help</a>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_poolOverview?.Error))
            {
                <div class="optional-feature-state warning"><strong>Pool health is unavailable.</strong><span>@_poolOverview.Error</span></div>
            }
            else if (_poolOverview?.Pools.Count > 0)
            {
                <div class="pool-health-grid">
                    @foreach (var pool in _poolOverview.Pools)
                    {
                        <article class="pool-health-card">
                            <div class="row"><strong>@pool.Name</strong><span class="badge @PoolClass(pool)">@pool.Status</span></div>
                            <div class="pool-capacity-row"><span><strong>@FormatBytes(pool.AllocatedBytes)</strong> used</span><span>@FormatBytes(pool.FreeBytes) free</span></div>
                            <div class="pool-capacity-track" role="progressbar" aria-label="@pool.Name storage used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(pool.UsedPercentage ?? 0)"><span style="@PoolProgressStyle(pool)"></span></div>
                            <div class="pool-card-meta"><span>@((pool.UsedPercentage ?? 0).ToString("0.#"))% of @FormatBytes(pool.SizeBytes)</span>@if (!string.IsNullOrWhiteSpace(pool.Fragmentation)) { <span>@pool.Fragmentation fragmented</span> }</div>
                            @if (!string.IsNullOrWhiteSpace(pool.StatusDetail))
                            {
                                <p class="pool-warning">@pool.StatusDetail</p>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="optional-feature-state"><span>No storage pools were returned by TrueNAS.</span></div>
            }
        </section>

        <div class="dashboard-operations-grid @(_overview.FavoriteApps.Count > 0 ? "has-favorites" : "without-favorites")">
            <section class="panel dashboard-last-run" aria-labelledby="last-run-heading">
                <div class="panel-heading-row">
                    <div>
                        <h2 id="last-run-heading">Last update run</h2>
                        <p class="muted">Most recent check or update automation.</p>
                    </div>
                    <a href="/history">View history</a>
                </div>
                @if (_overview.LastRun is null)
                {
                    <div class="empty-state compact"><p class="muted">No update runs have been recorded.</p></div>
                }
                else
                {
                    <div class="last-run-status">
                        <span class="badge @RunStatusClass(_overview.LastRun.Status)">@RunStatusText(_overview.LastRun.Status)</span>
                        <div>
                            <strong>@RunTriggerText(_overview.LastRun.Trigger)</strong>
                            <span>@RunTimeText(_overview.LastRun)</span>
                        </div>
                    </div>
                    <dl class="dashboard-run-metrics">
                        <div><dt>Checked</dt><dd>@_overview.LastRun.CheckedCount</dd></div>
                        <div><dt>Succeeded</dt><dd>@_overview.LastRun.SucceededCount</dd></div>
                        <div><dt>Failed</dt><dd>@_overview.LastRun.FailedCount</dd></div>
                        <div><dt>Skipped</dt><dd>@_overview.LastRun.SkippedCount</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_overview.LastRun.ErrorSummary))
                    {
                        <p class="dashboard-run-error">@_overview.LastRun.ErrorSummary</p>
                    }
                }
            </section>

            <section class="panel dashboard-attention" id="attention" aria-labelledby="attention-heading">
                <div class="panel-heading-row">
                    <div>
                        <h2 id="attention-heading">Needs attention</h2>
                        <p class="muted">Current app and Uptime Kuma issues.</p>
                    </div>
                    @if (AttentionCount() > 0)
                    {
                        <span class="badge danger">@AttentionCount() open</span>
                    }
                </div>

                @if (AttentionCount() == 0)
                {
                    <div class="dashboard-all-clear">
                        <span class="status-dot success" aria-hidden="true"></span>
                        <div><strong>All clear</strong><p class="muted">No installed apps or Kuma monitors currently report an outage.</p></div>
                    </div>
                }
                else
                {
                    <div class="dashboard-alert-list">
                        @foreach (var alert in _overview.AppAlerts.Take(5))
                        {
                            <article class="dashboard-alert-row">
                                <span class="dashboard-alert-icon app-alert" aria-hidden="true">A</span>
                                <div>
                                    <strong>@alert.Name</strong>
                                    <span>@(alert.Message ?? $"App is {HealthText(alert.HealthState).ToLowerInvariant()}.")</span>
                                </div>
                                <span class="badge @HealthClass(alert.HealthState)">@HealthText(alert.HealthState)</span>
                                <a href="@AppPath(alert.AppId)">View app</a>
                            </article>
                        }
                        @foreach (var alert in _overview.MonitorAlerts.Take(5))
                        {
                            <article class="dashboard-alert-row">
                                <span class="dashboard-alert-icon monitor-alert" aria-hidden="true">K</span>
                                <div>
                                    <strong>@alert.Name</strong>
                                    <span>@(alert.Target ?? "Uptime Kuma monitor is down.")</span>
                                </div>
                                <span class="badge danger">Down</span>
                                <a href="@(alert.AppId is null ? "/monitoring" : AppPath(alert.AppId))">View details</a>
                            </article>
                        }
                    </div>
                    @if (AttentionCount() > 10)
                    {
                        <p class="muted dashboard-more-alerts">Showing 10 of @AttentionCount() issues. <a href="/monitoring">View monitoring</a></p>
                    }
                }
            </section>

            @if (_overview.FavoriteApps.Count > 0)
            {
                <section class="panel dashboard-favorites" aria-labelledby="favorites-heading">
                    <div class="panel-heading-row">
                        <div>
                            <h2 id="favorites-heading">Favorite apps</h2>
                            <p class="muted">Pinned apps for quick access.</p>
                        </div>
                        <a href="/apps">View apps</a>
                    </div>
                    <div class="dashboard-favorite-list">
                        @foreach (var app in _overview.FavoriteApps.Take(6))
                        {
                            <a class="dashboard-favorite-row" href="@AppPath(app.AppId)">
                                <span class="dashboard-favorite-star" aria-hidden="true">★</span>
                                <span class="dashboard-favorite-copy">
                                    <strong>@app.Name</strong>
                                    <span>@FavoriteMeta(app)</span>
                                </span>
                                <span class="badge @HealthClass(app.HealthState)">@HealthText(app.HealthState)</span>
                            </a>
                        }
                    </div>
                    @if (_overview.FavoriteApps.Count > 6)
                    {
                        <p class="muted dashboard-more-favorites">Showing 6 of @_overview.FavoriteApps.Count favorite apps.</p>
                    }
                </section>
            }
        </div>

        <section class="panel server-status-bar dashboard-server-bar" aria-label="TrueNAS server status">
            <div class="server-status-identity">
                <span class="status-dot @(IsConnected() ? "success" : "danger")" aria-hidden="true"></span>
                <span>
                    <span class="server-status-label">TrueNAS server</span>
                    <strong class="server-status-address">@(_serverAddress?.HostName ?? "truenas.local")</strong>
                    <span class="server-status-host">@(_serverAddress?.DisplayAddress ?? "IP unavailable")</span>
                </span>
            </div>
            <div class="server-status-secondary">
                <div class="server-status-metadata">
                    <span>Connection <strong>@(IsConnected() ? "Connected" : "Not connected")</strong></span>
                    <span>Inventory <strong>@FormatDate(_overview.Settings.LastInventoryRefreshUtc)</strong></span>
                    <span>Update check <strong>@FormatDate(_overview.Settings.LastCompletedCheckUtc)</strong></span>
                </div>
                <div class="server-status-actions">
                    @if (!string.IsNullOrWhiteSpace(_serverActionMessage))
                    {
                        <span class="muted" role="status">@_serverActionMessage</span>
                    }
                    <button class="small" disabled="@(_serverAddress?.IsResolved != true)" @onclick="CopyServerIpAsync">Copy IP</button>
                    @if (_serverAddress is not null)
                    {
                        <a class="button small" href="@_serverAddress.WebUiUrl" target="_blank" rel="noopener noreferrer">Open TrueNAS ↗</a>
                    }
                </div>
            </div>
        </section>

        <section class="panel dashboard-freshness" aria-labelledby="freshness-heading">
            <div>
                <h2 id="freshness-heading">Data freshness</h2>
                <p class="muted">When each dashboard source last reported successfully.</p>
            </div>
            <dl>
                <div><dt>App inventory</dt><dd>@FormatDate(_overview.Settings.LastInventoryRefreshUtc)</dd></div>
                <div><dt>Update check</dt><dd>@FormatDate(_overview.Settings.LastCompletedCheckUtc)</dd></div>
                <div><dt>Uptime Kuma</dt><dd>@FormatDate(_overview.Settings.LastUptimeKumaSuccessUtc)</dd></div>
            </dl>
            <a href="/monitoring">Open monitoring reports</a>
        </section>
    }
</div>

@code {
    private DashboardOverview? _overview;
    private TrueNasServerAddress? _serverAddress;
    private StoragePoolOverview? _poolOverview;
    private bool _loading = true;
    private bool _poolLoading = true;
    private bool _messageIsError;
    private string? _message;
    private string? _serverActionMessage;
    private string _refreshStage = "Loading dashboard…";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_overview?.Settings.OnboardingCompleted == false)
        {
            Navigation.NavigateTo("/onboarding");
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            _refreshStage = "Refreshing apps, updates, and Kuma…";
            await InvokeAsync(StateHasChanged);
            var refresh = await DashboardRefreshService.RefreshAsync();

            _refreshStage = "Reloading dashboard…";
            await InvokeAsync(StateHasChanged);
            await LoadAsync();
            _messageIsError = !refresh.IsSuccessful;
            _message = refresh.Message;
        }
        catch
        {
            _message = "The dashboard could not be refreshed.";
            _messageIsError = true;
        }
        finally
        {
            _loading = false;
            _refreshStage = "Loading dashboard…";
        }
    }

    private async Task LoadAsync()
    {
        _overview = await DashboardService.GetAsync();
        _serverAddress = await ServerAddressService.GetAsync();
        await LoadPoolOverviewAsync();
        _loading = false;
    }

    private async Task LoadPoolOverviewAsync()
    {
        _poolLoading = true;
        _poolOverview = await PoolOverviewService.GetAsync();
        _poolLoading = false;
    }

    private async Task CopyServerIpAsync()
    {
        if (_serverAddress?.IsResolved != true)
        {
            return;
        }

        try
        {
            var copied = await JS.InvokeAsync<bool>("trueNasCommandCenter.copyText", _serverAddress.IpAddress);
            _serverActionMessage = copied ? "IP copied" : "Copy failed";
        }
        catch
        {
            _serverActionMessage = "Copy failed";
        }
    }

    private bool IsConnected() => _overview?.Settings.LastConnectionSuccessUtc is not null && _overview.Settings.LastConnectionErrorCode is null;
    private int AttentionCount() => (_overview?.AppAlerts.Count ?? 0) + (_overview?.MonitorAlerts.Count ?? 0);
    private string FormatDate(DateTime? value) => DisplayTimeFormatter.Format(value, _overview?.Settings.TimeZoneId);

    private string FormatNextRun()
    {
        if (_overview?.Settings is not { SchedulerEnabled: true } settings || string.IsNullOrWhiteSpace(settings.CronExpression) || string.IsNullOrWhiteSpace(settings.TimeZoneId))
        {
            return "Not set";
        }

        try
        {
            var next = ScheduleService.GetNextRun(settings.CronExpression, settings.TimeZoneId, DateTimeOffset.UtcNow);
            if (next is null)
            {
                return "Not set";
            }

            var zone = TimeZoneInfo.FindSystemTimeZoneById(settings.TimeZoneId);
            return TimeZoneInfo.ConvertTime(next.Value, zone).ToString("ddd h:mm tt");
        }
        catch (Exception exception) when (exception is TimeZoneNotFoundException or InvalidTimeZoneException or FormatException)
        {
            return "Invalid";
        }
    }

    private string RunTimeText(DashboardRunSummary run) => run.EndedUtc is null ? $"Started {FormatDate(run.StartedUtc)}" : $"Finished {FormatDate(run.EndedUtc)}";
    private static string FavoriteMeta(DashboardFavoriteApp app) => string.Join(" · ", new[] { app.GroupName, app.Version, app.HasUpdate ? "Update available" : null }.Where(value => !string.IsNullOrWhiteSpace(value))) is { Length: > 0 } description ? description : "Pinned app";
    private static string AppPath(string appId) => $"/apps/{Uri.EscapeDataString(appId)}";
    private static string HealthText(AppHealthState state) => state switch { AppHealthState.Running => "Running", AppHealthState.Degraded => "Degraded", AppHealthState.Stopped => "Stopped", AppHealthState.Maintenance => "Maintenance", _ => "Unknown" };
    private static string HealthClass(AppHealthState state) => state switch { AppHealthState.Running => "success", AppHealthState.Degraded => "warning", AppHealthState.Stopped => "danger", AppHealthState.Maintenance => "info", _ => string.Empty };
    private static string RunStatusText(RunStatus status) => status switch { RunStatus.PartiallySucceeded => "Partially succeeded", _ => status.ToString() };
    private static string RunStatusClass(RunStatus status) => status switch { RunStatus.Succeeded => "success", RunStatus.Failed => "danger", RunStatus.PartiallySucceeded => "warning", RunStatus.Running => "info", _ => string.Empty };
    private static string RunTriggerText(RunTrigger trigger) => trigger switch { RunTrigger.CheckAndUpdateNow => "Manual check & update", RunTrigger.CheckNow => "Manual check", RunTrigger.UpdateNow => "Manual app update", RunTrigger.Scheduled => "Scheduled check", _ => trigger.ToString() };
    private static string PoolClass(StoragePoolHealth pool) => pool.IsHealthy && !pool.HasWarning ? "success" : pool.HasWarning ? "warning" : "danger";
    private static string PoolProgressStyle(StoragePoolHealth pool) => $"width: {(pool.UsedPercentage ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null)
        {
            return "—";
        }

        string[] units = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"];
        var value = Math.Max(0, (double)bytes.Value);
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.#} {units[unitIndex]}";
    }
}

    private async Task ExportFullRecoveryBackupAsync()
    {
        await RunBackupActionAsync(async () =>
        {
            if (_exportPassword.Length < 12)
            {
                throw new InvalidOperationException("Use at least 12 characters for the full recovery backup password.");
            }

            if (!string.Equals(_exportPassword, _confirmExportPassword, StringComparison.Ordinal))
            {
                throw new InvalidOperationException("The full recovery backup passwords do not match.");
            }

            await PersistSettingsBeforeBackupAsync();
            var backup = await BackupService.ExportFullRecoveryAsync(_exportPassword);
            await JS.InvokeVoidAsync("trueNasCommandCenter.downloadText", backup.FileName, backup.Json, "application/json");
            _exportPassword = string.Empty;
            _confirmExportPassword = string.Empty;
            _message = "Saved current settings and downloaded a password-protected full recovery backup.";
        });
    }

    private async Task PersistSettingsBeforeBackupAsync()
    {
        if (_model is null)
        {
            throw new InvalidOperationException("Settings are still loading. Try the backup again.");
        }

        await SettingsService.SaveAsync(_model);
        await ReloadAsync();
    }

    private async Task SelectBackupAsync(InputFileChangeEventArgs eventArgs)
    {
        _busy = true;
        _message = null;
        _importInspection = null;
        _importPreview = null;
        _importContent = null;
        _importPassword = string.Empty;
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            _importContent = await reader.ReadToEndAsync();
            _importFileName = file.Name;
            _importInspection = BackupService.Inspect(_importContent);
            _message = "Full recovery backup selected. Enter its password, then validate it.";
            _error = false;
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }


    /// <summary>Persists the subscription change completed directly by the browser's user-gesture handler.</summary>
    /// <param name="action">The browser action, either enable or disable.</param>
    /// <param name="state">The resulting browser permission and subscription state.</param>
    /// <param name="endpoint">The endpoint removed by an unsubscribe action, when available.</param>
    /// <returns>A task that completes after the server-side subscription state is synchronized.</returns>
    [JSInvokable]
    public async Task OnPushBrowserActionAsync(string action, WebPushBrowserState state, string? endpoint)
    {
        try
        {
            if (string.Equals(action, "enable", StringComparison.Ordinal) && state.Subscription is not null)
            {
                await PushSubscriptionService.RegisterAsync(state.Subscription);
                _message = "Push notifications are enabled on this device.";
                _error = false;
            }
            else if (string.Equals(action, "disable", StringComparison.Ordinal))
            {
                if (!string.IsNullOrWhiteSpace(endpoint))
                {
                    await PushSubscriptionService.RemoveAsync(endpoint);
                }

                _message = "Push notifications are disabled on this device.";
                _error = false;
            }
            else
            {
                _message = state.Error ?? "The browser did not create a push subscription.";
                _error = true;
            }

            _pushState = state;
            _pushDevices = await PushSubscriptionService.ListAsync();
            _currentPushSubscriptionId = state.Subscription is null ? null : await PushSubscriptionService.FindIdByEndpointAsync(state.Subscription.Endpoint);
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }

        await InvokeAsync(StateHasChanged);
    }


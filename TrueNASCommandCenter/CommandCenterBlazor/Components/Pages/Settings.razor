@page "/settings"
@inject SettingsService SettingsService
@inject IScheduleService ScheduleService
@inject ITrueNasClient TrueNasClient
@inject IEmailNotificationSender EmailSender
@inject IWebhookNotificationSender WebhookSender
@inject IWebPushNotificationSender PushSender
@inject IWebPushSubscriptionService PushSubscriptionService
@inject IUpdateCoordinator Coordinator
@inject IAppDiscoveryService AppDiscoveryService
@inject IConfigurationBackupService BackupService
@inject IUptimeKumaClient UptimeKumaClient
@inject IUptimeKumaSyncService UptimeKumaSyncService
@inject TrueNasEndpointOptions TrueNasEndpoint
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Settings · TrueNAS Command Center</PageTitle>

<div class="page settings-page">
    <header class="page-header settings-header">
        <div>
            <h1>Settings</h1>
            <p class="subtitle">Connection, schedule, notifications, and safety. Running @ApplicationVersion.Display.</p>
        </div>
        <button class="primary" disabled="@(_busy || _model is null)" aria-busy="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save settings")</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice settings-toast @(_error ? "danger" : "success")" role="status">
            <span>@_message</span>
            <button class="notice-dismiss" type="button" aria-label="Dismiss message" @onclick="DismissMessage">×</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_record?.LastConnectionError))
    {
        <div class="notice danger" role="status">
            <strong>Last connection failure</strong>
            <p>@_record.LastConnectionError</p>
        </div>
    }

    <div class="tabs settings-tabs" role="tablist" aria-label="Settings sections">
        <button class="@TabClass("connection")" @onclick='() => _tab = "connection"'>Connection</button>
        <button class="@TabClass("monitoring")" @onclick='() => _tab = "monitoring"'>Uptime Kuma</button>
        <button class="@TabClass("schedule")" @onclick='() => _tab = "schedule"'>Schedule</button>
        <button class="@TabClass("notifications")" @onclick='() => _tab = "notifications"'>Notifications</button>
        <button class="@TabClass("advanced")" @onclick='() => _tab = "advanced"'>Advanced / Safety</button>
        <button class="@TabClass("backup")" @onclick='() => _tab = "backup"'>Backup &amp; restore</button>
    </div>

    @if (_model is null)
    {
        <div class="panel empty-state state-loading"><span class="spinner"></span><strong>Loading settings…</strong></div>
    }
    else if (_tab == "connection")
    {
        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>TrueNAS connection</h2>
                    <p class="field-help">The deployment connects securely to <code>@TrueNasEndpoint.ServerUrl</code>. Core app management requires <code>APPS_READ</code> and <code>APPS_WRITE</code>; the Discover gallery also requires <code>CATALOG_READ</code>.</p>
                </div>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="truenas-user">Username</label>
                    <input id="truenas-user" autocomplete="username" @bind="_model.TrueNasUsername" />
                </div>
                <div class="field">
                    <label for="truenas-key">API key</label>
                    <input id="truenas-key" type="password" autocomplete="new-password"
                           placeholder="@(_model.HasSavedTrueNasApiKey ? "Saved — enter to replace" : "Enter API key")"
                           @bind="_model.NewTrueNasApiKey" />
                    <p class="field-help">Stored encrypted and never returned to the browser after save.</p>
                </div>
            </div>

            <div class="toggle-row" style="margin-top:1rem">
                <input id="verify-tls" type="checkbox" @bind="_model.VerifyTls" />
                <div>
                    <label for="verify-tls">Verify TLS certificate</label>
                    <p class="field-help">Keep enabled when the TrueNAS certificate is trusted and covers <code>@TrueNasEndpoint.ServerUri.Host</code>.</p>
                </div>
            </div>

            @if (!_model.VerifyTls)
            {
                <div class="notice warning">Certificate identity verification is disabled. The connection remains encrypted with WSS, but the server identity is not verified.</div>
            }

            <TrueNasPermissionGuide />

            <div class="actions" style="margin-top:1rem">
                <button disabled="@_busy" @onclick="TestConnectionAsync">Test connection</button>
            </div>
        </section>
    }
    else if (_tab == "monitoring")
    {
        <div class="split-layout">
            <section class="panel">
                <div class="panel-header">
                    <div>
                        <h2>Uptime Kuma integration</h2>
                        <p class="field-help">Imports read-only Prometheus metrics. Uptime Kuma remains responsible for probes, alerts, and incident history.</p>
                    </div>
                </div>

                <div class="field">
                    <label for="kuma-base-url">Connection URL</label>
                    <input id="kuma-base-url" type="url" placeholder="http://truenas.local:3001" @bind="_model.UptimeKumaBaseUrl" />
                    <p class="field-help">Used by this container to request <code>/metrics</code>. Enter the complete reachable URL, not only a port. Do not use 127.0.0.1 for another container.</p>
                </div>
                <div class="field" style="margin-top:1rem">
                    <label for="kuma-browser-url">Browser URL</label>
                    <input id="kuma-browser-url" type="url" placeholder="https://status.example.com" @bind="_model.UptimeKumaBrowserUrl" />
                    <p class="field-help">Optional address used by Open Uptime Kuma links. It may differ from the server-to-server connection URL.</p>
                </div>
                <div class="field" style="margin-top:1rem">
                    <label for="kuma-api-key">Prometheus API key</label>
                    <input id="kuma-api-key" type="password" autocomplete="new-password"
                           placeholder="@(_model.HasSavedUptimeKumaApiKey ? "Saved — enter to replace" : "Optional when Kuma authentication is disabled")"
                           @bind="_model.NewUptimeKumaApiKey" />
                    <p class="field-help">Create this in Uptime Kuma under Settings → Security → API Keys. Stored encrypted and never displayed again.</p>
                </div>

                <div class="form-grid" style="margin-top:1rem">
                    <div class="toggle-row">
                        <input id="kuma-verify-tls" type="checkbox" @bind="_model.UptimeKumaVerifyTls" />
                        <div><label for="kuma-verify-tls">Verify TLS certificate</label><p class="field-help">Keep enabled unless the connection URL intentionally uses an untrusted self-signed certificate.</p></div>
                    </div>
                    <div class="field">
                        <label for="kuma-refresh">Refresh interval (seconds)</label>
                        <input id="kuma-refresh" type="number" min="30" max="3600" @bind="_model.UptimeKumaRefreshIntervalSeconds" />
                    </div>
                </div>

                @if (!_model.UptimeKumaVerifyTls)
                {
                    <div class="notice warning">Uptime Kuma server identity verification is disabled for the metrics connection.</div>
                }

                <div class="actions" style="margin-top:1rem">
                    <button disabled="@_busy" @onclick="TestUptimeKumaAsync">Test connection</button>
                    <button class="primary" disabled="@_busy" @onclick="SyncUptimeKumaAsync">Sync now</button>
                    <a class="button" href="/monitoring">View monitoring</a>
                </div>
                <p class="field-help">Saving a connection URL starts automatic imports on the configured interval. Testing validates the saved connection, and Sync now imports a report immediately.</p>
            </section>

            <aside>
                <section class="panel">
                    <h2>Connection state</h2>
                    <dl class="details-list">
                        <dt>Status</dt><dd>@(!string.IsNullOrWhiteSpace(_record?.UptimeKumaBaseUrl) ? "Automatic" : "Not configured")</dd>
                        <dt>Last attempt</dt><dd>@FormatDate(_record?.LastUptimeKumaSyncUtc)</dd>
                        <dt>Last success</dt><dd>@FormatDate(_record?.LastUptimeKumaSuccessUtc)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_record?.LastUptimeKumaError))
                    {
                        <div class="notice danger"><strong>Last sync failed</strong><p>@_record.LastUptimeKumaError</p></div>
                    }
                    else if (_record?.LastUptimeKumaSuccessUtc is not null)
                    {
                        <p><span class="status-dot success"></span>Metrics imported successfully</p>
                    }
                    else
                    {
                        <p class="muted">No metrics have been imported yet.</p>
                    }
                </section>
                <section class="panel">
                    <h2>Read-only boundary</h2>
                    <p>The manager reads Kuma's supported Prometheus endpoint. It does not create probes, change monitors, send Kuma notifications, or store Kuma administrator credentials.</p>
                </section>
            </aside>
        </div>
    }
    else if (_tab == "schedule")
    {
        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>Schedule</h2>
                    <p class="field-help">The manager schedules its own runs; no TrueNAS cron task is created.</p>
                </div>
                <input aria-label="Scheduler enabled" type="checkbox" @bind="_model.SchedulerEnabled" />
            </div>

            <div class="form-grid">
                <div class="field">
                    <label for="cron">Cron expression</label>
                    <input id="cron" placeholder="5 fields: minute hour day month weekday" @bind="_model.CronExpression" />
                    <p class="field-help">Seconds fields are rejected.</p>
                </div>
                <div class="field">
                    <label for="timezone">IANA timezone</label>
                    <select id="timezone" @bind="_model.TimeZoneId">
                        <option value="">Select a timezone</option>
                        @if (!string.IsNullOrWhiteSpace(_model.TimeZoneId) && !IanaTimeZoneCatalog.Ids.Contains(_model.TimeZoneId, StringComparer.Ordinal))
                        {
                            <option value="@_model.TimeZoneId">@_model.TimeZoneId</option>
                        }
                        @foreach (var timeZoneId in IanaTimeZoneCatalog.Ids)
                        {
                            <option value="@timeZoneId">@timeZoneId</option>
                        }
                    </select>
                </div>
            </div>

            <div class="actions" style="margin-top:1rem">
                <button @onclick="PreviewSchedule">Validate &amp; preview</button>
                <button disabled="@_busy" @onclick="() => RunCheckAsync(false)">Run check now</button>
                <button class="primary" disabled="@_busy" @onclick="() => RunCheckAsync(true)">Run check &amp; update now</button>
            </div>

            @if (_schedulePreview is not null)
            {
                <div class="notice @(_schedulePreview.IsValid ? "" : "danger")" style="margin-top:1rem">
                    @if (_schedulePreview.IsValid)
                    {
                        <strong>Valid schedule.</strong>
                        <p>@_schedulePreview.Preview</p>
                        <ol>
                            @foreach (var run in _schedulePreview.NextRuns)
                            {
                                <li>@run.ToString("yyyy-MM-dd h:mm:ss tt zzz")</li>
                            }
                        </ol>
                    }
                    else
                    {
                        @_schedulePreview.Error
                    }
                </div>
            }

            <dl class="details-list" style="margin-top:1.25rem">
                <dt>Last scheduled run</dt><dd>@FormatDate(_record?.LastScheduledRunUtc)</dd>
                <dt>Last inventory refresh</dt><dd>@FormatDate(_record?.LastInventoryRefreshUtc)</dd>
                <dt>Last completed check</dt><dd>@FormatDate(_record?.LastCompletedCheckUtc)</dd>
            </dl>
        </section>
    }
    else if (_tab == "notifications")
    {
        <div class="split-layout">
            <section>
                <div class="panel">
                    <h2>Notification events</h2>
                    <p class="field-help">Choose update and system events below. App downtime and recovery follow each app's downtime setting.</p>
                    <div class="toggle-row"><input id="notify-manual" type="checkbox" @bind="_model.NotifyManualApproval" /><label for="notify-manual">Manual-approval update available</label></div>
                    <div class="toggle-row"><input id="notify-failed" type="checkbox" @bind="_model.NotifyAutomaticFailure" /><label for="notify-failed">Automatic update failed</label></div>
                    <div class="toggle-row"><input id="notify-blocked" type="checkbox" @bind="_model.NotifyAutomaticBlocked" /><label for="notify-blocked">Automatic update blocked</label></div>
                    <div class="toggle-row"><input id="notify-rollback" type="checkbox" @bind="_model.NotifyRollback" /><label for="notify-rollback">Rollback occurred</label></div>
                    <div class="toggle-row"><input id="notify-success" type="checkbox" @bind="_model.NotifyAutomaticSuccess" /><label for="notify-success">Automatic update succeeded</label></div>
                    <div class="toggle-row"><input id="notify-check-failed" type="checkbox" @bind="_model.NotifyScheduledCheckFailure" /><label for="notify-check-failed">Scheduled check failed</label></div>
                    <div class="toggle-row"><input id="notify-connection" type="checkbox" @bind="_model.NotifyConnectionFailure" /><label for="notify-connection">TrueNAS connection/authentication failed</label></div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h2>TrueNAS email</h2>
                            <p class="field-help">Uses the mail service already configured in TrueNAS through the authenticated API connection.</p>
                        </div>
                        <input aria-label="Email enabled" type="checkbox" @bind="_model.EmailEnabled" />
                    </div>
                    <div class="field">
                        <label for="recipients">Optional recipients, one per line</label>
                        <textarea id="recipients" placeholder="Leave blank to notify TrueNAS administrators" @bind="_model.EmailRecipients"></textarea>
                        <p class="field-help">When blank, TrueNAS sends to local administrators that have email addresses configured. Configure the TrueNAS mail service and at least one administrator address before testing.</p>
                    </div>
                    <button disabled="@_busy" @onclick="TestEmailAsync">Send test email</button>
                </div>
            </section>

            <aside>
                <section class="panel push-notifications-panel">
                    <div class="panel-header">
                        <div>
                            <h2>Browser push</h2>
                            <p class="field-help">Receive a generic system notification on this browser when an enabled alert event occurs.</p>
                        </div>
                        @if (_pushState?.Subscription is not null)
                        {
                            <span class="badge success">This device enabled</span>
                        }
                    </div>

                    @if (_pushState is null)
                    {
                        <p class="muted"><span class="spinner"></span> Checking browser support…</p>
                    }
                    else if (!_pushState.Supported)
                    {
                        <div class="notice warning">
                            <div>
                                <strong>Push is unavailable in this browser.</strong>
                                <p>@_pushState.Error</p>
                            </div>
                        </div>
                    }
                    else if (string.Equals(_pushState.Permission, "denied", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="notice danger">
                            <div>
                                <strong>Notifications are blocked.</strong>
                                <p>Allow notifications for this site in browser settings, then reload this page.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label for="push-device-name">Device name</label>
                            <input id="push-device-name" maxlength="128" placeholder="Optional, for example Kitchen iPad" @bind="_pushDeviceName" />
                        </div>
                        <div class="actions push-actions">
                            @if (_pushState.Subscription is null)
                            {
                                <button type="button" class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_pushPublicKey))" data-push-enable data-push-public-key="@_pushPublicKey">Enable on this device</button>
                            }
                            else
                            {
                                <button type="button" disabled="@_busy" data-push-disable>Disable on this device</button>
                            }
                            <button type="button" disabled="@(_busy || _pushDevices.Count == 0)" @onclick="TestPushAsync">Send test push</button>
                        </div>
                    }

                    <p class="field-help push-privacy-note">Push covers downtime, failed recovery, manual approval, blocked or failed updates, rollbacks, scheduled-check failures, and TrueNAS connection failures. Success-only events remain available through email and webhooks. Requires HTTPS (except localhost) plus outbound HTTPS access from the Command Center container to each browser-provided push endpoint. On iPhone or iPad, install the PWA to the Home Screen first. Push services receive no app names, server details, or error text; open the dashboard for details.</p>

                    @if (_pushDevices.Count > 0)
                    {
                        <div class="push-device-list">
                            <h3>Registered devices <span class="count-badge">@_pushDevices.Count</span></h3>
                            @foreach (var device in _pushDevices)
                            {
                                <div class="push-device-row">
                                    <div>
                                        <strong>@device.DeviceName</strong>
                                        <span class="field-help">Seen @FormatDate(device.LastSeenUtc)@if (device.ConsecutiveFailures > 0){<text> · @device.ConsecutiveFailures failed delivery attempt(s)</text>}</span>
                                    </div>
                                    @if (device.Id == _currentPushSubscriptionId)
                                    {
                                        <span class="badge">Current</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="compact" disabled="@_busy" @onclick="() => RemovePushDeviceAsync(device.Id)">Forget</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <h2>Generic webhook</h2>
                        <input aria-label="Webhook enabled" type="checkbox" @bind="_model.WebhookEnabled" />
                    </div>
                    <div class="field">
                        <label for="webhook-url">URL</label>
                        <input id="webhook-url" type="url" placeholder="https://example.invalid/hooks/truenas" @bind="_model.WebhookUrl" />
                    </div>
                    <div class="field" style="margin-top:1rem">
                        <label for="webhook-auth">Authorization value</label>
                        <input id="webhook-auth" type="password" autocomplete="new-password"
                               placeholder="@(_model.HasSavedWebhookAuthorization ? "Saved — enter to replace" : "Optional")"
                               @bind="_model.NewWebhookAuthorization" />
                    </div>
                    <div class="field" style="margin-top:1rem">
                        <label for="webhook-headers">Secret custom headers</label>
                        <textarea id="webhook-headers"
                                  placeholder="@(_model.HasSavedWebhookHeaders ? "Saved — enter new Name: Value lines to replace" : "Name: Value")"
                                  @bind="_model.WebhookHeaders"></textarea>
                        <p class="field-help">All custom header values are encrypted and never logged.</p>
                    </div>
                    <div class="field" style="margin-top:1rem">
                        <label for="webhook-timeout">Timeout (seconds)</label>
                        <input id="webhook-timeout" type="number" min="1" max="120" @bind="_model.WebhookTimeoutSeconds" />
                    </div>
                    <button style="margin-top:1rem" disabled="@_busy" @onclick="TestWebhookAsync">Send test webhook</button>
                </section>
            </aside>
        </div>
    }
    else if (_tab == "advanced")
    {
        <section class="panel">
            <h2>Advanced / Safety</h2>
            <div class="form-grid">
                <div class="field">
                    <label for="manager-id">This manager's TrueNAS app ID</label>
                    <input id="manager-id" placeholder="truenas-command-center" @bind="_model.ManagerAppId" />
                    <p class="field-help">Matching app IDs are always blocked from self-update.</p>
                </div>
                <div class="field">
                    <label for="portal-host">Local TrueNAS Web UI host</label>
                    <input id="portal-host" type="url" placeholder="http://truenas.local" @bind="_model.PortalHostOverride" />
                    <p class="field-help">Defaults to <code>http://truenas.local</code>. Set an override only when your TrueNAS host uses a different local name or HTTPS origin.</p>
                </div>
                <div class="toggle-row">
                    <input id="github-enrichment" type="checkbox" @bind="_model.GitHubEnrichmentEnabled" />
                    <div><label for="github-enrichment">GitHub repository enrichment</label><p class="field-help">Fetch public repository facts only for canonical github.com sources. Cached for 24 hours.</p></div>
                </div>
                <div class="field">
                    <label for="verify-timeout">Post-update verification timeout (seconds)</label>
                    <input id="verify-timeout" type="number" min="30" max="1800" @bind="_model.VerificationTimeoutSeconds" />
                </div>
                <div class="field">
                    <label for="failure-cooldown">Connection notification cooldown (minutes)</label>
                    <input id="failure-cooldown" type="number" min="1" max="10080" @bind="_model.ConnectionFailureCooldownMinutes" />
                </div>
                <div class="field">
                    <label for="retention">History retention (days)</label>
                    <input id="retention" type="number" min="1" placeholder="Blank keeps history indefinitely" @bind="_model.HistoryRetentionDays" />
                    <p class="field-help">Cleanup occurs after scheduled runs. Blank retains history indefinitely.</p>
                </div>
            </div>
        </section>

        <section class="panel">
            <h2>Security boundary</h2>
            <p>This app never uses Docker commands, privileged mode, or the Docker socket. All lifecycle actions use TrueNAS middleware.</p>
            <p class="muted">V1 has no built-in authentication. Expose this UI only on a trusted LAN/VPN or behind an authenticated reverse proxy.</p>
        </section>
    }
    else
    {
        <div class="backup-layout">
            <section class="panel backup-panel">
                <h2>Download backup</h2>
                <p class="field-help">Save your settings and credentials in one password-protected JSON file.</p>
                <div class="backup-password-grid">
                    <div class="field">
                        <label for="export-password">Password</label>
                        <input id="export-password" type="password" autocomplete="new-password" @bind="_exportPassword" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="confirm-export-password">Confirm password</label>
                        <input id="confirm-export-password" type="password" autocomplete="new-password" @bind="_confirmExportPassword" @bind:event="oninput" />
                    </div>
                </div>
                <p class="field-help backup-password-help">Use at least 12 characters. You will need this password to restore.</p>
                <button class="primary" disabled="@_busy" @onclick="ExportFullRecoveryBackupAsync">Download backup</button>
            </section>

            <section class="panel backup-panel">
                <h2>Restore backup</h2>
                <p class="field-help">Select a backup file and enter its password.</p>
                <div class="field">
                    <label for="backup-file">Backup file</label>
                    <InputFile id="backup-file" accept=".json,application/json" OnChange="SelectBackupAsync" />
                </div>

                @if (_importInspection is not null)
                {
                    <div class="backup-summary">
                        <dl class="details-list">
                            <dt>File</dt><dd>@_importFileName</dd>
                            <dt>Schema</dt><dd>@_importInspection.SchemaVersion</dd>
                            <dt>Exported</dt><dd>@DisplayTimeFormatter.Format(_importInspection.ExportedAtUtc.UtcDateTime, "UTC")</dd>
                            <dt>App version</dt><dd>@_importInspection.ApplicationVersion</dd>
                        </dl>
                    </div>

                    <div class="field backup-password-field">
                        <label for="import-password">Password</label>
                        <input id="import-password" type="password" autocomplete="current-password" @bind="_importPassword" @bind:event="oninput" @bind:after="ResetImportPreview" />
                    </div>

                    <div class="actions backup-actions">
                        <button disabled="@(_busy || string.IsNullOrWhiteSpace(_importPassword))" @onclick="PreviewImportAsync">Preview</button>
                        @if (_importPreview is not null)
                        {
                            <button class="primary" disabled="@_busy" @onclick="ImportBackupAsync">Restore backup</button>
                        }
                    </div>
                }

                @if (_importPreview is not null)
                {
                    <div class="notice success backup-preview" role="status">
                        <strong>Ready to restore.</strong>
                        @_importPreview.AppCount app settings will be imported.
                    </div>
                }
            </section>
        </div>
    }

</div>

@code {
    private SettingsFormModel? _model;
    private SettingsRecord? _record;
    private ScheduleValidationResult? _schedulePreview;
    private string _tab = "connection";
    private string? _message;
    private bool _error;
    private bool _busy;
    private string _exportPassword = string.Empty;
    private string _confirmExportPassword = string.Empty;
    private string _importPassword = string.Empty;
    private string? _importContent;
    private string? _importFileName;
    private ConfigurationBackupInspection? _importInspection;
    private ConfigurationBackupPreview? _importPreview;
    private string? _pushPublicKey;
    private string _pushDeviceName = string.Empty;
    private WebPushBrowserState? _pushState;
    private IReadOnlyList<WebPushSubscriptionSummary> _pushDevices = [];
    private DotNetObjectReference<Settings>? _pushCallback;
    private Guid? _currentPushSubscriptionId;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _model = await SettingsService.GetFormAsync();
        _record = await SettingsService.GetRecordAsync();
        _pushPublicKey = await PushSubscriptionService.GetPublicKeyAsync();
        _pushDevices = await PushSubscriptionService.ListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _pushCallback = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("trueNasPwa.setPushCallback", _pushCallback);
            _pushState = await JS.InvokeAsync<WebPushBrowserState>("trueNasPwa.getPushState");
            _currentPushSubscriptionId = _pushState.Subscription is null ? null : await PushSubscriptionService.FindIdByEndpointAsync(_pushState.Subscription.Endpoint);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException exception)
        {
            _pushState = new WebPushBrowserState(false, false, "unsupported", null, exception.Message);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissMessage()
    {
        _message = null;
        _error = false;
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_model.SchedulerEnabled)
            {
                _schedulePreview = ScheduleService.Validate(_model.CronExpression, _model.TimeZoneId);
                if (!_schedulePreview.IsValid)
                {
                    throw new InvalidOperationException(_schedulePreview.Error);
                }
            }

            await SettingsService.SaveAsync(_model);
            _message = "Settings saved.";
            _error = false;
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }


    private async Task ImportBackupAsync()
    {
        if (_importContent is null || _importPreview is null)
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", $"Restore all global settings, credentials, and {_importPreview.AppCount} app configurations from this full recovery backup? Existing history and unlisted apps will be preserved."))
        {
            return;
        }

        await RunBackupActionAsync(async () =>
        {
            var result = await BackupService.ImportAsync(_importContent, _importPassword);
            await TrueNasClient.ResetConnectionAsync();
            var refreshMessage = "";
            if (result.ConnectionReady)
            {
                try
                {
                    var refresh = await AppDiscoveryService.RefreshAsync();
                    refreshMessage = $" Inventory refreshed with {refresh.Discovered} installed apps.";
                }
                catch (Exception exception)
                {
                    refreshMessage = $" Configuration was restored, but inventory refresh failed: {exception.Message}";
                }
            }
            else
            {
                refreshMessage = " Enter the TrueNAS API key before refreshing inventory.";
            }

            _message = $"Restored {result.AppsRestored} app configurations.{refreshMessage}";
            _importContent = null;
            _importFileName = null;
            _importInspection = null;
            _importPreview = null;
            _importPassword = string.Empty;
            await ReloadAsync();
        });
    }

    private async Task RunBackupActionAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            _error = false;
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }


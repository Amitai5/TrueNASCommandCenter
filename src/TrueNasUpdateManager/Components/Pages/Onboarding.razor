@page "/onboarding"
@inject SettingsService SettingsService
@inject ITrueNasClient TrueNasClient
@inject IScheduleService ScheduleService
@inject IEmailNotificationSender EmailSender
@inject IWebhookNotificationSender WebhookSender
@inject IUpdateCoordinator Coordinator
@inject NavigationManager Navigation
@inject TrueNasEndpointOptions TrueNasEndpoint

<PageTitle>Setup · TrueNAS Update Manager</PageTitle>

<div class="page" style="max-width:900px">
    <header class="page-header">
        <div>
            <h1>First launch setup</h1>
            <p class="subtitle">Step @_step of 4 · No app updates until you explicitly configure policies.</p>
        </div>
        <div class="actions">
            <a class="button small" href="/help#first-connection" target="_blank" rel="noopener">Setup help ↗</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_error ? "danger" : "success")">@_message</div>
    }

    @if (_model is null)
    {
        <div class="panel empty-state"><span class="spinner"></span> Loading…</div>
    }
    else if (_step == 1)
    {
        <section class="panel">
            <h2>1. TrueNAS connection</h2>
            <p class="muted">The manager connects to <code>@TrueNasEndpoint.ServerUri.Host</code> using the secure endpoint configured in the app deployment. Enter a service account/API key with APPS_READ and APPS_WRITE.</p>
            <div class="form-grid">
                <div class="field">
                    <label for="wizard-user">Username</label>
                    <input id="wizard-user" autocomplete="username" @bind="_model.TrueNasUsername" />
                </div>
                <div class="field">
                    <label for="wizard-key">API key</label>
                    <input id="wizard-key" type="password" autocomplete="new-password"
                           placeholder="@(_model.HasSavedTrueNasApiKey ? "Saved — enter to replace" : "")"
                           @bind="_model.NewTrueNasApiKey" />
                </div>
            </div>
            <div class="toggle-row"><input id="wizard-tls" type="checkbox" @bind="_model.VerifyTls" /><label for="wizard-tls">Verify TLS certificate (disable only for an untrusted or mismatched certificate)</label></div>
            <div class="actions" style="justify-content:space-between;margin-top:1rem">
                <button disabled="@_busy" @onclick="TestConnectionAsync">Test connection</button>
                <button class="primary" disabled="@_busy || !_connectionTested" @onclick="NextAsync">Continue</button>
            </div>
        </section>
    }
    else if (_step == 2)
    {
        <section class="panel">
            <h2>2. Schedule</h2>
            <div class="toggle-row"><input id="wizard-schedule" type="checkbox" @bind="_model.SchedulerEnabled" /><label for="wizard-schedule">Enable scheduled checks and updates</label></div>
            @if (_model.SchedulerEnabled)
            {
                <div class="form-grid">
                    <div class="field">
                        <label for="wizard-cron">5-field cron expression</label>
                        <input id="wizard-cron" placeholder="minute hour day month weekday" @bind="_model.CronExpression" />
                    </div>
                    <div class="field">
                        <label for="wizard-zone">IANA timezone</label>
                        <input id="wizard-zone" placeholder="Area/City" @bind="_model.TimeZoneId" />
                    </div>
                </div>
                <button style="margin-top:1rem" @onclick="PreviewSchedule">Validate schedule</button>
                @if (_preview is not null)
                {
                    <div class="notice @(_preview.IsValid ? "" : "danger")" style="margin-top:1rem">
                        @(_preview.IsValid ? _preview.Preview : _preview.Error)
                    </div>
                }
            }
            else
            {
                <p class="muted">No schedule or timezone will be preconfigured. Manual checks remain available.</p>
            }
            @WizardNavigation()
        </section>
    }
    else if (_step == 3)
    {
        <section class="panel">
            <h2>3. Notifications</h2>
            <p class="muted">Providers and events are optional. Nothing is enabled implicitly.</p>

            <div class="form-grid">
                <div>
                    <div class="toggle-row"><input id="wizard-email" type="checkbox" @bind="_model.EmailEnabled" /><label for="wizard-email">Configure email</label></div>
                    @if (_model.EmailEnabled)
                    {
                        <div class="field"><label for="wiz-smtp-host">SMTP host</label><input id="wiz-smtp-host" @bind="_model.SmtpHost" /></div>
                        <div class="form-grid" style="margin-top:.7rem">
                            <div class="field"><label for="wiz-smtp-port">Port</label><input id="wiz-smtp-port" type="number" @bind="_model.SmtpPort" /></div>
                            <div class="field">
                                <label for="wiz-smtp-security">Security</label>
                                <select id="wiz-smtp-security" @bind="_model.SmtpSecurity">
                                    <option value="">Choose…</option>
                                    <option value="@SmtpSecurity.None">None</option>
                                    <option value="@SmtpSecurity.StartTls">STARTTLS</option>
                                    <option value="@SmtpSecurity.Tls">TLS/SSL</option>
                                </select>
                            </div>
                        </div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-smtp-user">Username</label><input id="wiz-smtp-user" @bind="_model.SmtpUsername" /></div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-smtp-password">Password</label><input id="wiz-smtp-password" type="password" autocomplete="new-password" @bind="_model.NewSmtpPassword" /></div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-from">From address</label><input id="wiz-from" type="email" @bind="_model.EmailFromAddress" /></div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-recipients">Recipients</label><textarea id="wiz-recipients" @bind="_model.EmailRecipients"></textarea></div>
                        <button style="margin-top:.7rem" disabled="@_busy" @onclick="TestEmailAsync">Send test email</button>
                    }
                </div>

                <div>
                    <div class="toggle-row"><input id="wizard-webhook" type="checkbox" @bind="_model.WebhookEnabled" /><label for="wizard-webhook">Configure generic webhook</label></div>
                    @if (_model.WebhookEnabled)
                    {
                        <div class="field"><label for="wiz-hook-url">Webhook URL</label><input id="wiz-hook-url" type="url" @bind="_model.WebhookUrl" /></div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-hook-auth">Authorization value</label><input id="wiz-hook-auth" type="password" autocomplete="new-password" @bind="_model.NewWebhookAuthorization" /></div>
                        <div class="field" style="margin-top:.7rem"><label for="wiz-hook-headers">Secret headers</label><textarea id="wiz-hook-headers" placeholder="Name: Value" @bind="_model.WebhookHeaders"></textarea></div>
                        <button style="margin-top:.7rem" disabled="@_busy" @onclick="TestWebhookAsync">Send test webhook</button>
                    }
                </div>
            </div>

            <h3 style="margin-top:1.5rem">Events</h3>
            <div class="form-grid">
                <div class="toggle-row"><input id="wiz-manual" type="checkbox" @bind="_model.NotifyManualApproval" /><label for="wiz-manual">Manual approval available</label></div>
                <div class="toggle-row"><input id="wiz-failed" type="checkbox" @bind="_model.NotifyAutomaticFailure" /><label for="wiz-failed">Automatic update failed</label></div>
                <div class="toggle-row"><input id="wiz-blocked" type="checkbox" @bind="_model.NotifyAutomaticBlocked" /><label for="wiz-blocked">Automatic update blocked</label></div>
                <div class="toggle-row"><input id="wiz-rollback" type="checkbox" @bind="_model.NotifyRollback" /><label for="wiz-rollback">Rollback occurred</label></div>
                <div class="toggle-row"><input id="wiz-success" type="checkbox" @bind="_model.NotifyAutomaticSuccess" /><label for="wiz-success">Automatic update succeeded</label></div>
                <div class="toggle-row"><input id="wiz-check" type="checkbox" @bind="_model.NotifyScheduledCheckFailure" /><label for="wiz-check">Scheduled check failed</label></div>
                <div class="toggle-row"><input id="wiz-connection" type="checkbox" @bind="_model.NotifyConnectionFailure" /><label for="wiz-connection">Connection/authentication failed</label></div>
            </div>
            @WizardNavigation()
        </section>
    }
    else
    {
        <section class="panel">
            <h2>4. Discover apps</h2>
            <p>All discovered apps begin <strong>Unconfigured</strong>. Discovery checks status but does not update apps or send policy notifications.</p>
            <button class="primary" disabled="@_busy" @onclick="DiscoverAsync">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                Discover apps
            </button>
            <div class="actions" style="justify-content:space-between;margin-top:1.5rem">
                <button @onclick="Back">Back</button>
                @if (_discoveryComplete)
                {
                    <button class="primary" @onclick="Finish">Review app policies</button>
                }
            </div>
        </section>
    }
</div>

@code {
    private SettingsFormModel? _model;
    private ScheduleValidationResult? _preview;
    private int _step = 1;
    private bool _connectionTested;
    private bool _discoveryComplete;
    private bool _busy;
    private bool _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsService.GetFormAsync();
        if (_model.OnboardingCompleted)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_model is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await SettingsService.SaveAsync(_model);
            await TrueNasClient.ResetConnectionAsync();
            var result = await TrueNasClient.TestConnectionAsync();
            _connectionTested = result.Success;
            _message = result.Message;
            _error = !result.Success;
            _model = await SettingsService.GetFormAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NextAsync()
    {
        if (_model is null)
        {
            return;
        }

        if (_step == 2 && _model.SchedulerEnabled)
        {
            _preview = ScheduleService.Validate(_model.CronExpression, _model.TimeZoneId);
            if (!_preview.IsValid)
            {
                _message = _preview.Error;
                _error = true;
                return;
            }
        }

        try
        {
            await SettingsService.SaveAsync(_model);
            _model = await SettingsService.GetFormAsync();
            _step++;
            _message = null;
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
    }

    private void PreviewSchedule()
    {
        if (_model is not null)
        {
            _preview = ScheduleService.Validate(_model.CronExpression, _model.TimeZoneId);
        }
    }

    private async Task TestEmailAsync() => await TestNotificationAsync(EmailSender.SendAsync, "Test email");

    private async Task TestWebhookAsync() => await TestNotificationAsync(WebhookSender.SendAsync, "Test webhook");

    private async Task TestNotificationAsync(
        Func<NotificationEvent, CancellationToken, Task<NotificationDeliveryResult>> sender,
        string subject)
    {
        if (_model is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await SettingsService.SaveAsync(_model);
            var test = new NotificationEvent(
                Guid.NewGuid(),
                NotificationEventType.ScheduledCheckFailed,
                DateTime.UtcNow,
                $"test|{Guid.NewGuid()}",
                subject,
                "This is a setup test from TrueNAS App Update Manager.",
                "TEST");
            var result = await sender(test, CancellationToken.None);
            _message = result.Success ? $"{subject} delivered." : result.Error;
            _error = !result.Success;
            _model = await SettingsService.GetFormAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscoverAsync()
    {
        if (_model is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Coordinator.RunAsync(RunTrigger.CheckNow, executeUpdates: false);
            _discoveryComplete = result.Status == RunStatus.Succeeded;
            _message = _discoveryComplete
                ? $"Discovery complete. {result.Checked} apps are ready for policy review."
                : result.Message;
            _error = !_discoveryComplete;
            if (_discoveryComplete)
            {
                _model.OnboardingCompleted = true;
                await SettingsService.SaveAsync(_model);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Back()
    {
        _step = Math.Max(1, _step - 1);
        _message = null;
    }

    private void Finish() => Navigation.NavigateTo("/");

    private RenderFragment WizardNavigation() => @<div class="actions" style="justify-content:space-between;margin-top:1.5rem">
        <button @onclick="Back">Back</button>
        <button class="primary" disabled="@_busy" @onclick="NextAsync">Continue</button>
    </div>;
}

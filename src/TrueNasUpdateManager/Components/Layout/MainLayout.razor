@inherits LayoutComponentBase
@inject SettingsService SettingsService

<div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/">
            <span class="brand-mark">TA</span>
            <span>TrueNAS<br /><strong>Update Manager</strong></span>
        </a>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">
                <span aria-hidden="true">◉</span> Apps
            </NavLink>
            <NavLink href="/history">
                <span aria-hidden="true">≡</span> History
            </NavLink>
            <NavLink href="/settings">
                <span aria-hidden="true">⚙</span> Settings
            </NavLink>
        </nav>
        <div class="sidebar-footer">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch color theme" aria-pressed="false">
                <span data-theme-icon aria-hidden="true">◐</span>
                <span data-theme-label>Theme</span>
            </button>
            <div class="sidebar-status">
                <span class="status-dot @(_connected ? "success" : "muted")"></span>
                @(_connected ? "Connected" : "Not connected")
            </div>
        </div>
    </aside>

    <main>
        @Body
    </main>

    <nav class="mobile-nav" aria-label="Primary navigation">
        <NavLink href="/" Match="NavLinkMatch.All"><span>◉</span>Apps</NavLink>
        <NavLink href="/history"><span>≡</span>History</NavLink>
        <NavLink href="/settings"><span>⚙</span>Settings</NavLink>
        <button type="button" class="theme-toggle mobile-theme-toggle" data-theme-toggle aria-label="Switch color theme" aria-pressed="false">
            <span data-theme-icon aria-hidden="true">◐</span>
            <span data-theme-label>Theme</span>
        </button>
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool _connected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingsService.GetRecordAsync();
            _connected = settings.LastConnectionSuccessUtc is not null &&
                         settings.LastConnectionErrorCode is null;
        }
        catch
        {
            _connected = false;
        }
    }
}

@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="page state-page">
    <section class="panel empty-state">
        <span class="state-icon danger" aria-hidden="true">!</span>
        <h1>Something went wrong</h1>
        <p class="muted">The request could not be completed. Try reloading the page, then check the app logs if the problem continues.</p>
        @if (ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@RequestId</code></p>
        }
        <div class="actions state-actions">
            <a class="button primary" href=".">Reload</a>
            <a class="button" href="/">Back to apps</a>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

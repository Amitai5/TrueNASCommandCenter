@page "/apps/{AppId}/policy"
@page "/apps/{AppId}/settings"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAppLinkService AppLinkService
@inject NavigationManager Navigation

<PageTitle>App settings · TrueNAS App Manager</PageTitle>

<div class="page policy-page">
    @if (_app is null)
    {
        <div class="panel empty-state">
            <h1>App not found</h1>
            <a class="button" href="/">Back to apps</a>
        </div>
    }
    else
    {
        <header class="page-header">
            <div>
                <a href="/">← Apps</a>
                <h1 style="margin-top:.6rem">@_app.Name settings</h1>
                <p class="subtitle">Updates, availability, access, and monitoring · @(_app.IsCustom ? "Custom" : "Catalog")</p>
            </div>
            <span class="badge">@_app.State</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="notice @(_error ? "danger" : "success")">@_message</div>
        }

        <div class="split-layout policy-layout">
            <section class="panel policy-form">
                <div class="app-settings-intro">
                    <div>
                        <span class="eyebrow">Application settings</span>
                        <h2>Manage @_app.Name</h2>
                        <p class="field-help">Changes apply only to this application.</p>
                    </div>
                    <span class="badge @(_app.ActionRequired ? "danger" : "success")">
                        @(_app.ActionRequired ? "Action required" : "No action required")
                    </span>
                </div>

                <section class="app-settings-section" aria-labelledby="update-settings-heading">
                    <div class="app-settings-section-header">
                        <span class="settings-section-number" aria-hidden="true">1</span>
                        <div><h2 id="update-settings-heading">Updates</h2><p class="field-help">Choose how updates are handled and which safeguards run first.</p></div>
                    </div>
                    <div class="form-grid">
                    <div class="field full">
                        <label for="policy">Update policy</label>
                        <select id="policy" @bind="_selectedPolicy">
                            <option value="">Unconfigured</option>
                            <option value="@AppPolicy.AutoUpdate">Auto update</option>
                            <option value="@AppPolicy.NotifyOnly">Notify only</option>
                            <option value="@AppPolicy.Ignore">Ignore</option>
                        </select>
                        <p class="field-help">
                            Unconfigured apps are checked and shown, but never update automatically or send policy notifications.
                        </p>
                    </div>

                    @if (_selectedPolicy == AppPolicy.AutoUpdate)
                    {
                        <div class="field full">
                            <label for="scope">Version scope</label>
                            <select id="scope" @bind="_versionScope" disabled="@_app.IsCustom">
                                <option value="@VersionScope.AnyVersion">Any version</option>
                                <option value="@VersionScope.MinorAndPatch">Minor + patch only</option>
                                <option value="@VersionScope.PatchOnly">Patch only</option>
                            </select>
                            <p class="field-help">
                                @if (_app.ImageUpdateAvailable && !_app.CatalogUpdateAvailable)
                                {
                                    <span>Version scope does not apply to image-only updates.</span>
                                }
                                else
                                {
                                    <span>Unclear versions require manual approval unless Any version is selected.</span>
                                }
                            </p>
                        </div>
                    }
                    </div>

                    <div class="settings-subgroup">
                        <div class="toggle-row">
                            <input id="snapshot" type="checkbox" @bind="_snapshotHostPaths" />
                            <div>
                                <label for="snapshot">Snapshot host paths before catalog upgrade</label>
                                <p class="field-help">Requests TrueNAS host-path snapshots when supported.</p>
                            </div>
                        </div>

                        <div class="field">
                            <label for="notify-success">Notify on successful update</label>
                            <select id="notify-success" @bind="_notifyChoice">
                                <option value="inherit">Inherit global setting</option>
                                <option value="on">On</option>
                                <option value="off">Off</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="app-settings-section" aria-labelledby="availability-settings-heading">
                    <div class="app-settings-section-header">
                        <span class="settings-section-number" aria-hidden="true">2</span>
                        <div><h2 id="availability-settings-heading">Availability &amp; safety</h2><p class="field-help">Control downtime handling and planned maintenance behavior.</p></div>
                    </div>
                    <div class="field">
                        <label for="downtime-action">When this app is down</label>
                        <select id="downtime-action" @bind="_downtimeAction">
                            <option value="@DowntimeAction.Ignore">Ignore</option>
                            <option value="@DowntimeAction.NotifyOnly">Notify only</option>
                            <option value="@DowntimeAction.RestartAndNotify">Restart once and notify</option>
                        </select>
                        <p class="field-help">A recovery attempt happens at most once per incident. Recovery and failed recovery are both reported.</p>
                    </div>

                    <div class="toggle-row" style="margin-top:1rem"><input id="maintenance" type="checkbox" @bind="_maintenanceMode" /><div><label for="maintenance">Maintenance mode</label><p class="field-help">Suppress downtime actions while you intentionally service this app. Starting or restarting it here clears maintenance automatically.</p></div></div>
                </section>

                <section class="app-settings-section" aria-labelledby="access-settings-heading">
                    <div class="app-settings-section-header">
                        <span class="settings-section-number" aria-hidden="true">3</span>
                        <div><h2 id="access-settings-heading">Web UI access</h2><p class="field-help">Choose where this app opens from local and remote manager routes.</p></div>
                    </div>
                    <div class="form-grid">
                        <div class="field">
                            <label for="local-portal">Local Web UI URL</label>
                            <input id="local-portal" type="url" placeholder="http://truenas.local:10704/web" @bind="_localPortalUrl" />
                            <p class="field-help">Optional override for local access. Leave blank to use a TrueNAS portal or the published port on <code>truenas.local</code>.</p>
                        </div>
                        <div class="field">
                            <label for="remote-portal">Remote Web UI URL</label>
                            <input id="remote-portal" type="url" placeholder="https://plex.example.com" @bind="_remotePortalUrl" />
                            <p class="field-help">Used from public App Manager domains. Remote addresses are never guessed.</p>
                        </div>
                    </div>
                </section>

                <section class="app-settings-section" aria-labelledby="monitoring-settings-heading">
                    <div class="app-settings-section-header">
                        <span class="settings-section-number" aria-hidden="true">4</span>
                        <div><h2 id="monitoring-settings-heading">Monitoring</h2><p class="field-help">Associate Uptime Kuma reports with this application.</p></div>
                    </div>
                    <div class="field">
                    <div class="panel-header">
                        <div><label>Uptime Kuma monitors</label><p class="field-help">Link one or more Kuma probes to this app. Kuma availability remains separate from the TrueNAS runtime state.</p></div>
                        @if (_uptimeKumaMonitors.Any(IsSuggestedMonitor))
                        {
                            <button class="small" type="button" @onclick="SelectSuggestedMonitors">Select suggested</button>
                        }
                    </div>
                    @if (_uptimeKumaMonitors.Count == 0)
                    {
                        <p class="muted">No Uptime Kuma monitors have been imported. <a href="/settings">Configure the integration</a>, then sync it.</p>
                    }
                    else
                    {
                        <div class="monitor-picker">
                            @foreach (var monitor in _uptimeKumaMonitors)
                            {
                                <label class="monitor-picker-item">
                                    <input type="checkbox" checked="@_selectedMonitorIds.Contains(monitor.MonitorId)" @onchange="eventArgs => ToggleMonitor(monitor.MonitorId, eventArgs.Value is true)" />
                                    <span><strong>@monitor.Name</strong><small>@MonitorTarget(monitor) · @monitor.Status @if (IsSuggestedMonitor(monitor)) { <text>· Suggested</text> }</small></span>
                                </label>
                            }
                        </div>
                    }
                    </div>
                </section>

                <div class="form-action-bar">
                    <span>Save all app settings and return to details.</span>
                    <div class="actions">
                        <button disabled="@_saving" @onclick="Cancel">Cancel</button>
                        <button class="primary" disabled="@_saving" aria-busy="@_saving" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save & return")</button>
                    </div>
                </div>
            </section>

            <aside>
                <section class="panel">
                    <h2>At a glance</h2>
                    <dl class="details-list">
                        <dt>App ID</dt><dd>@_app.Id</dd>
                        <dt>Installed</dt><dd>@(_app.HumanVersion ?? _app.InstalledVersion ?? "Unknown")</dd>
                        <dt>Available</dt><dd>@AvailableText()</dd>
                        <dt>State</dt><dd>@_app.State</dd>
                        <dt>Last check</dt><dd>@FormatDate(_app.LastCheckUtc)</dd>
                        <dt>Last manager update</dt><dd>@FormatDate(_app.LastSuccessfulUpdateUtc)</dd>
                    </dl>
                </section>

                <section class="panel">
                    <h2>Safety state</h2>
                    @if (_app.ActionRequired)
                    {
                        <div class="notice danger">
                            TrueNAS reports <code>action_required</code>. Automatic execution is blocked.
                        </div>
                    }
                    else
                    {
                        <p><span class="status-dot success"></span>No TrueNAS action required</p>
                    }
                    <a class="button" href="@AppPath()">View details</a>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public string AppId { get; set; } = string.Empty;

    private AppRecord? _app;
    private AppPolicy? _selectedPolicy;
    private VersionScope _versionScope;
    private bool _snapshotHostPaths;
    private string _notifyChoice = "inherit";
    private DowntimeAction _downtimeAction;
    private bool _maintenanceMode;
    private string? _localPortalUrl;
    private string? _remotePortalUrl;
    private List<UptimeKumaMonitorRecord> _uptimeKumaMonitors = [];
    private HashSet<string> _selectedMonitorIds = new(StringComparer.Ordinal);
    private bool _saving;
    private bool _error;
    private string? _message;
    private string? _timeZoneId;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _app = await db.Apps.AsNoTracking().Include(app => app.Ports).SingleOrDefaultAsync(app => app.Id == AppId);
        _timeZoneId = (await db.Settings.AsNoTracking().SingleAsync(item => item.Id == 1)).TimeZoneId;
        _uptimeKumaMonitors = await db.UptimeKumaMonitors.AsNoTracking().Where(monitor => monitor.IsPresent).OrderBy(monitor => monitor.Name).ToListAsync();
        if (_app is null)
        {
            return;
        }

        _selectedPolicy = _app.Policy;
        _versionScope = _app.VersionScope;
        _snapshotHostPaths = _app.SnapshotHostPaths;
        _downtimeAction = _app.DowntimeAction;
        _maintenanceMode = _app.MaintenanceMode;
        _localPortalUrl = _app.LocalPortalUrl;
        _remotePortalUrl = _app.RemotePortalUrl;
        _selectedMonitorIds = _uptimeKumaMonitors.Where(monitor => monitor.AppId == AppId).Select(monitor => monitor.MonitorId).ToHashSet(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(_localPortalUrl) && string.IsNullOrWhiteSpace(_remotePortalUrl) && Uri.TryCreate(_app.ManualPortalUrl, UriKind.Absolute, out var legacyPortal))
        {
            if (AppLinkService.ClassifyRoute(legacyPortal) == WebUiRoute.Local)
            {
                _localPortalUrl = legacyPortal.AbsoluteUri;
            }
            else
            {
                _remotePortalUrl = legacyPortal.AbsoluteUri;
            }
        }
        _notifyChoice = _app.NotifySuccessOverride switch
        {
            true => "on",
            false => "off",
            _ => "inherit"
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var app = await db.Apps.SingleAsync(item => item.Id == AppId);
            app.Policy = _selectedPolicy;
            app.VersionScope = _versionScope;
            app.SnapshotHostPaths = _snapshotHostPaths;
            app.NotifySuccessOverride = _notifyChoice switch
            {
                "on" => true,
                "off" => false,
                _ => null
            };
            app.DowntimeAction = _downtimeAction;
            app.NotifyOnDowntime = _downtimeAction != DowntimeAction.Ignore;
            app.MaintenanceMode = _maintenanceMode;
            app.LocalPortalUrl = NormalizeWebUiUrl(_localPortalUrl, "Local Web UI URL");
            app.RemotePortalUrl = NormalizeWebUiUrl(_remotePortalUrl, "Remote Web UI URL");
            app.ManualPortalUrl = null;
            var previouslyLinkedMonitors = await db.UptimeKumaMonitors.Where(monitor => monitor.AppId == AppId).ToListAsync();
            foreach (var monitor in previouslyLinkedMonitors)
            {
                monitor.AppId = null;
            }
            var selectedMonitors = await db.UptimeKumaMonitors.Where(monitor => _selectedMonitorIds.Contains(monitor.MonitorId)).ToListAsync();
            foreach (var monitor in selectedMonitors)
            {
                monitor.AppId = AppId;
            }
            if (app.DowntimeAction == DowntimeAction.Ignore)
            {
                app.DowntimeNotificationActive = false;
                app.HealthIncidentId = null;
                app.RecoveryAttemptedUtc = null;
            }
            if (app.Policy is null)
            {
                app.StatusLabel = "Needs configuration";
            }
            else if (app.CatalogUpdateAvailable)
            {
                app.StatusLabel = "Update available";
            }
            else if (app.ImageUpdateAvailable)
            {
                app.StatusLabel = "Image update";
            }
            else
            {
                app.StatusLabel = "Up to date";
            }

            await db.SaveChangesAsync();
            Navigation.NavigateTo($"{AppPath()}?saved=settings", replace: true);
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo(AppPath());

    private string AppPath() => $"/apps/{Uri.EscapeDataString(AppId)}";

    private string AvailableText() =>
        _app?.CatalogUpdateAvailable == true
            ? _app.LatestHumanVersion ?? _app.LatestVersion ?? "Catalog update"
            : _app?.ImageUpdateAvailable == true ? "Image update" : "No update";

    private string FormatDate(DateTime? value) => DisplayTimeFormatter.Format(value, _timeZoneId);

    private static string? NormalizeWebUiUrl(string? value, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (!Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps) ||
            string.IsNullOrWhiteSpace(uri.Host) ||
            !string.IsNullOrEmpty(uri.UserInfo))
        {
            throw new InvalidOperationException($"{label} must be an absolute HTTP or HTTPS URL without embedded credentials.");
        }

        return uri.AbsoluteUri;
    }

    private void ToggleMonitor(string monitorId, bool selected)
    {
        if (selected)
        {
            _selectedMonitorIds.Add(monitorId);
        }
        else
        {
            _selectedMonitorIds.Remove(monitorId);
        }
    }

    private void SelectSuggestedMonitors()
    {
        foreach (var monitor in _uptimeKumaMonitors.Where(IsSuggestedMonitor))
        {
            _selectedMonitorIds.Add(monitor.MonitorId);
        }
    }

    private bool IsSuggestedMonitor(UptimeKumaMonitorRecord monitor)
    {
        if (_app is null)
        {
            return false;
        }

        var normalizedAppName = NormalizeIdentity(_app.Name);
        if (!string.IsNullOrWhiteSpace(normalizedAppName) && NormalizeIdentity(monitor.Name).Contains(normalizedAppName, StringComparison.Ordinal))
        {
            return true;
        }

        return monitor.Port is not null && _app.Ports.Any(port => port.HostPort == monitor.Port);
    }

    private static string NormalizeIdentity(string value) => new(value.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());
    private static string MonitorTarget(UptimeKumaMonitorRecord monitor) => monitor.Url ?? (monitor.Hostname is not null ? $"{monitor.Hostname}{(monitor.Port is null ? string.Empty : $":{monitor.Port}")}" : monitor.Port?.ToString() ?? "Target unavailable");
}

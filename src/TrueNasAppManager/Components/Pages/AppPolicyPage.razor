@page "/apps/{AppId}/policy"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>App policy · TrueNAS App Manager</PageTitle>

<div class="page">
    @if (_app is null)
    {
        <div class="panel empty-state">
            <h1>App not found</h1>
            <a class="button" href="/">Back to apps</a>
        </div>
    }
    else
    {
        <header class="page-header">
            <div>
                <a href="/">← Apps</a>
                <h1 style="margin-top:.6rem">App policy</h1>
                <p class="subtitle">@_app.Name · @(_app.IsCustom ? "Custom" : "Catalog")</p>
            </div>
            <span class="badge">@_app.State</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="notice @(_error ? "danger" : "success")">@_message</div>
        }

        <div class="split-layout">
            <section class="panel">
                <div class="panel-header">
                    <h2>Update policy</h2>
                    <span class="badge @(_app.ActionRequired ? "danger" : "success")">
                        @(_app.ActionRequired ? "Action required" : "No action required")
                    </span>
                </div>

                <div class="form-grid">
                    <div class="field full">
                        <label for="policy">Policy</label>
                        <select id="policy" @bind="_selectedPolicy">
                            <option value="">Unconfigured</option>
                            <option value="@AppPolicy.AutoUpdate">Auto update</option>
                            <option value="@AppPolicy.NotifyOnly">Notify only</option>
                            <option value="@AppPolicy.Ignore">Ignore</option>
                        </select>
                        <p class="field-help">
                            Unconfigured apps are checked and shown, but never update automatically or send policy notifications.
                        </p>
                    </div>

                    @if (_selectedPolicy == AppPolicy.AutoUpdate)
                    {
                        <div class="field full">
                            <label for="scope">Version scope</label>
                            <select id="scope" @bind="_versionScope" disabled="@_app.IsCustom">
                                <option value="@VersionScope.AnyVersion">Any version</option>
                                <option value="@VersionScope.MinorAndPatch">Minor + patch only</option>
                                <option value="@VersionScope.PatchOnly">Patch only</option>
                            </select>
                            <p class="field-help">
                                @if (_app.ImageUpdateAvailable && !_app.CatalogUpdateAvailable)
                                {
                                    <span>Version scope does not apply to image-only updates.</span>
                                }
                                else
                                {
                                    <span>Unclear versions require manual approval unless Any version is selected.</span>
                                }
                            </p>
                        </div>
                    }
                </div>

                <hr style="border:0;border-top:1px solid var(--border);margin:1.25rem 0" />
                <h3>Safety</h3>
                <div class="toggle-row">
                    <input id="snapshot" type="checkbox" @bind="_snapshotHostPaths" />
                    <div>
                        <label for="snapshot">Snapshot host paths before catalog upgrade</label>
                        <p class="field-help">Requests TrueNAS host-path snapshots when supported.</p>
                    </div>
                </div>

                <div class="field" style="margin-top:1rem">
                    <label for="notify-success">Notify on successful update</label>
                    <select id="notify-success" @bind="_notifyChoice">
                        <option value="inherit">Inherit global setting</option>
                        <option value="on">On</option>
                        <option value="off">Off</option>
                    </select>
                </div>

                <div class="field" style="margin-top:1rem">
                    <label for="downtime-action">When this app is down</label>
                    <select id="downtime-action" @bind="_downtimeAction">
                        <option value="@DowntimeAction.Ignore">Ignore</option>
                        <option value="@DowntimeAction.NotifyOnly">Notify only</option>
                        <option value="@DowntimeAction.RestartAndNotify">Restart once and notify</option>
                    </select>
                    <p class="field-help">A recovery attempt happens at most once per incident. Recovery and failed recovery are both reported.</p>
                </div>

                <div class="toggle-row" style="margin-top:1rem"><input id="maintenance" type="checkbox" @bind="_maintenanceMode" /><div><label for="maintenance">Maintenance mode</label><p class="field-help">Suppress downtime actions while you intentionally service this app. Starting or restarting it here clears maintenance automatically.</p></div></div>

                <div class="field" style="margin-top:1rem"><label for="manual-portal">Manual Web UI URL</label><input id="manual-portal" type="url" placeholder="https://app.example.com" @bind="_manualPortalUrl" /><p class="field-help">Optional explicit HTTP or HTTPS link. This takes priority over TrueNAS portals.</p></div>

                <div class="actions" style="justify-content:flex-end;margin-top:1.5rem">
                    <button @onclick="Cancel">Cancel</button>
                    <button class="primary" disabled="@_saving" @onclick="SaveAsync">Save policy</button>
                </div>
            </section>

            <aside>
                <section class="panel">
                    <h2>App details</h2>
                    <dl class="details-list">
                        <dt>App ID</dt><dd>@_app.Id</dd>
                        <dt>Installed</dt><dd>@(_app.HumanVersion ?? _app.InstalledVersion ?? "Unknown")</dd>
                        <dt>Available</dt><dd>@AvailableText()</dd>
                        <dt>State</dt><dd>@_app.State</dd>
                        <dt>Last check</dt><dd>@FormatDate(_app.LastCheckUtc)</dd>
                        <dt>Last manager update</dt><dd>@FormatDate(_app.LastSuccessfulUpdateUtc)</dd>
                    </dl>
                </section>

                <section class="panel">
                    <h2>Safety state</h2>
                    @if (_app.ActionRequired)
                    {
                        <div class="notice danger">
                            TrueNAS reports <code>action_required</code>. Automatic execution is blocked.
                        </div>
                    }
                    else
                    {
                        <p><span class="status-dot success"></span>No TrueNAS action required</p>
                    }
                    <a class="button" href="@AppPath()">View details</a>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public string AppId { get; set; } = string.Empty;

    private AppRecord? _app;
    private AppPolicy? _selectedPolicy;
    private VersionScope _versionScope;
    private bool _snapshotHostPaths;
    private string _notifyChoice = "inherit";
    private DowntimeAction _downtimeAction;
    private bool _maintenanceMode;
    private string? _manualPortalUrl;
    private bool _saving;
    private bool _error;
    private string? _message;
    private string? _timeZoneId;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _app = await db.Apps.AsNoTracking().SingleOrDefaultAsync(app => app.Id == AppId);
        _timeZoneId = (await db.Settings.AsNoTracking().SingleAsync(item => item.Id == 1)).TimeZoneId;
        if (_app is null)
        {
            return;
        }

        _selectedPolicy = _app.Policy;
        _versionScope = _app.VersionScope;
        _snapshotHostPaths = _app.SnapshotHostPaths;
        _downtimeAction = _app.DowntimeAction;
        _maintenanceMode = _app.MaintenanceMode;
        _manualPortalUrl = _app.ManualPortalUrl;
        _notifyChoice = _app.NotifySuccessOverride switch
        {
            true => "on",
            false => "off",
            _ => "inherit"
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var app = await db.Apps.SingleAsync(item => item.Id == AppId);
            app.Policy = _selectedPolicy;
            app.VersionScope = _versionScope;
            app.SnapshotHostPaths = _snapshotHostPaths;
            app.NotifySuccessOverride = _notifyChoice switch
            {
                "on" => true,
                "off" => false,
                _ => null
            };
            if (!string.IsNullOrWhiteSpace(_manualPortalUrl) && (!Uri.TryCreate(_manualPortalUrl, UriKind.Absolute, out var portal) || (portal.Scheme != Uri.UriSchemeHttp && portal.Scheme != Uri.UriSchemeHttps)))
            {
                throw new InvalidOperationException("Manual Web UI URL must use HTTP or HTTPS.");
            }
            app.DowntimeAction = _downtimeAction;
            app.NotifyOnDowntime = _downtimeAction != DowntimeAction.Ignore;
            app.MaintenanceMode = _maintenanceMode;
            app.ManualPortalUrl = string.IsNullOrWhiteSpace(_manualPortalUrl) ? null : _manualPortalUrl.Trim();
            if (app.DowntimeAction == DowntimeAction.Ignore)
            {
                app.DowntimeNotificationActive = false;
                app.HealthIncidentId = null;
                app.RecoveryAttemptedUtc = null;
            }
            if (app.Policy is null)
            {
                app.StatusLabel = "Needs configuration";
            }
            else if (app.CatalogUpdateAvailable)
            {
                app.StatusLabel = "Update available";
            }
            else if (app.ImageUpdateAvailable)
            {
                app.StatusLabel = "Image update";
            }
            else
            {
                app.StatusLabel = "Up to date";
            }

            await db.SaveChangesAsync();
            _message = "Policy saved.";
            _error = false;
            await OnParametersSetAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _error = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo(AppPath());

    private string AppPath() => $"/apps/{Uri.EscapeDataString(AppId)}";

    private string AvailableText() =>
        _app?.CatalogUpdateAvailable == true
            ? _app.LatestHumanVersion ?? _app.LatestVersion ?? "Catalog update"
            : _app?.ImageUpdateAvailable == true ? "Image update" : "No update";

    private string FormatDate(DateTime? value) => DisplayTimeFormatter.Format(value, _timeZoneId);
}
